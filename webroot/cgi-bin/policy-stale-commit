#!/system/bin/sh
echo "Content-Type: application/json"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo "Pragma: no-cache"
echo "Expires: 0"
echo

MODDIR="/data/adb/modules/tirnsecurity"
DATA_DIR="/data/adb/tirnsecurity"
BODY_FILE="$DATA_DIR/policy-stale-body.$$"

[ "$REQUEST_METHOD" = "POST" ] || {
    printf '{"status":"ERROR","error":"Method not allowed"}\n'
    exit 1
}

CONTENT_LENGTH="${CONTENT_LENGTH:-0}"

case "$CONTENT_LENGTH" in
    ""|*[!0-9]*)
        printf '{"status":"ERROR","error":"Invalid request body"}\n'
        exit 1
        ;;
esac


if [ "$CONTENT_LENGTH" -gt 1048576 ]; then
    printf '{"status":"ERROR","error":"Request too large"}\n'
    exit 1
fi

umask 077

if ! cat > "$BODY_FILE"; then
    rm -f "$BODY_FILE"
    printf '{"status":"ERROR","error":"Unable to read request body"}\n'
    exit 1
fi


if [ -f "$DATA_DIR/test.env" ]; then
    . "$DATA_DIR/test.env"
fi

if /system/bin/sh "$MODDIR/service.sh" --reconcile-stale-policy < "$BODY_FILE"; then
    rm -f "$BODY_FILE"
    printf '{"status":"OK","message":"Stale policy reconciliation committed"}\n'
else
    rm -f "$BODY_FILE"
    printf '{"status":"ERROR","message":"Stale policy reconciliation transaction failed"}\n'
    exit 1
fi
