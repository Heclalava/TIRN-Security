#!/system/bin/sh

MODDIR="/data/adb/modules/tirnsecurity"
DATA_DIR="/data/adb/tirnsecurity"
APP_AUDIT="$MODDIR/appaudit"

if [ -x /system/bin/awk ]; then
    AWK="/system/bin/awk"
elif [ -x /system/xbin/awk ]; then
    AWK="/system/xbin/awk"
else
    exit 1
fi

WORK="$DATA_DIR/log-export.$$"
REPORT="$WORK/TIRN-security-report"
ARCHIVE="$WORK/TIRN-security-report.zip"
LOCK="$DATA_DIR/log-export.lock"

umask 077

cleanup() {
    rm -rf "$WORK"
    rmdir "$LOCK" 2>/dev/null
}

trap cleanup EXIT

if ! mkdir "$LOCK" 2>/dev/null; then
    exit 1
fi

mkdir -p "$REPORT" || exit 1

if [ ! -x "$APP_AUDIT" ]; then
    exit 1
fi

"$APP_AUDIT" "$DATA_DIR/apps.json" "$REPORT/apps-audit.txt" || exit 1

if [ -s "$DATA_DIR/policy.conf" ]; then
    "$APP_AUDIT" --policy "$DATA_DIR/apps.json" "$DATA_DIR/policy.conf" "$REPORT/policy.conf" || exit 1
fi

if [ -s "$DATA_DIR/policy.applied" ]; then
    "$APP_AUDIT" --policy "$DATA_DIR/apps.json" "$DATA_DIR/policy.applied" "$REPORT/policy.applied" || exit 1
fi

GENERATED="$(/system/bin/date '+%Y-%m-%d %H:%M:%S %Z%z' 2>/dev/null)"
DEVICE="$(/system/bin/getprop ro.product.model 2>/dev/null)"
ANDROID="$(/system/bin/getprop ro.build.version.release 2>/dev/null)"
MODULE_VERSION=""
if [ -f "$MODDIR/module.prop" ]; then
    MODULE_VERSION="$("$AWK" -F= '$1 == "version" {print substr($0,index($0,"=")+1); exit}' "$MODDIR/module.prop" 2>/dev/null)"
fi

{
    printf '%s\n' '================================================'
    printf '%s\n' 'TIRN Security Diagnostic Report'
    printf 'Generated: %s\n' "$GENERATED"
    printf 'Device: %s\n' "$DEVICE"
    printf 'Android: %s\n' "$ANDROID"
    printf 'TIRN Security: %s\n' "${MODULE_VERSION:-Unknown}"
    printf '%s\n' '================================================'
    printf '\n%s\n' 'Included files'
    printf '%s\n' '---------------'
} > "$REPORT/report.txt"

for FILE in \
    service.log \
    debug.log \
    installation.log \
    httpd.log
do
    if [ -s "$DATA_DIR/$FILE" ]; then
        cp -f "$DATA_DIR/$FILE" "$REPORT/$FILE" || exit 1
        printf '%s\n' "$FILE" >> "$REPORT/report.txt"
    else
        printf '%s (not present or empty)\n' "$FILE" >> "$REPORT/report.txt"
    fi
done

printf '%s\n' 'apps-audit.txt' >> "$REPORT/report.txt"
if [ -s "$REPORT/policy.conf" ]; then
    printf '%s\n' 'policy.conf (Configured Policy)' >> "$REPORT/report.txt"
fi
if [ -s "$REPORT/policy.applied" ]; then
    printf '%s\n' 'policy.applied (Applied Policy)' >> "$REPORT/report.txt"
fi
printf '\n%s\n' 'End of report.' >> "$REPORT/report.txt"

FILES="report.txt apps-audit.txt policy.conf policy.applied service.log debug.log installation.log httpd.log"

set -- $FILES
ZIP_FILES=""
for FILE
do
    if [ -s "$REPORT/$FILE" ]; then
        ZIP_FILES="$ZIP_FILES $FILE"
    fi
done

"$APP_AUDIT" --zip "$ARCHIVE" "$REPORT" $ZIP_FILES || exit 1

[ -s "$ARCHIVE" ] || exit 1

printf '%s\n' 'Content-Type: application/zip'
STAMP=$(date '+%Y%m%d-%H%M')
printf '%s\n' "Content-Disposition: attachment; filename=\"TIRN-security-report-$STAMP.zip\"; filename*=UTF-8''TIRN-security-report-$STAMP.zip"
printf '%s\n' 'Cache-Control: no-store, no-cache, must-revalidate, max-age=0'
printf '%s\n' 'Pragma: no-cache'
printf '%s\n' 'Expires: 0'
printf '\n'

cat "$ARCHIVE"
