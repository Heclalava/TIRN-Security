#!/system/bin/sh
echo "Content-Type: application/json"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo "Pragma: no-cache"
echo "Expires: 0"
echo
DATA_DIR="/data/adb/tirnsecurity"
POLICY="$DATA_DIR/policy.conf"
APPS="$DATA_DIR/apps.json"

if [ "$REQUEST_METHOD" != "GET" ]; then
    printf '%s\n' '{"status":"ERROR","error":"Method not allowed"}'
    exit 1
fi
if [ ! -f "$POLICY" ] || [ ! -f "$APPS" ]; then
    printf '%s\n' '{"status":"ERROR","error":"Policy or application cache is missing"}'
    exit 1
fi

awk -F'|' -v apps="$APPS" -v policy="$POLICY" '
function esc(s,t) {
    t=s
    gsub(/\\/, "\\\\", t)
    gsub(/"/, "\\\"", t)
    gsub(/\r/, "\\r", t)
    gsub(/\n/, "\\n", t)
    return t
}
function jval(o,k,r,x) {
    r="\"" k "\"[[:space:]]*:[[:space:]]*\"[^\"]*\"";
    if (match(o,r)) {
        x=substr(o,RSTART,RLENGTH)
        sub("^\"" k "\"[[:space:]]*:[[:space:]]*\"", "", x)
        sub("\"$", "", x)
        return x
    }
    return ""
}
function process_app(o,u,p,id,n,key) {
    u=jval(o,"user")
    p=jval(o,"pkg")
    id=jval(o,"uid")
    n=jval(o,"name")
    if (u!="" && p!="" && id!="") {
            key=u SUBSEP p
            app_uid[key]=id
            app_name[key]=n
    }
}
function app_char(c) {
    if (inq) {
        obj[depth]=obj[depth] c
        if (escp) escp=0
        else if (c=="\\") escp=1
        else if (c=="\"") inq=0
        return
    }
    if (c=="\"") {
        if (depth>0) obj[depth]=obj[depth] c
        inq=1
        return
    }
    if (c=="{"){
        depth++
        obj[depth]="{"
        return
    }
    if (depth>0) {
        obj[depth]=obj[depth] c
        if (c=="}") {
            process_app(obj[depth])
            delete obj[depth]
            depth--
        }
    }
}
FILENAME==apps{
    for (i=1; i<=length($0); i++)
        app_char(substr($0,i,1))
    next
}
FILENAME==policy{
    if (NF!=5 || $5!="BLOCK")
        next
    total++
    user=$1
    pkg=$2
    olduid=$3
    network=$4
    k=user SUBSEP pkg
    if (!(k in app_uid)) {
        reason="APP_MISSING"
        stale++
        skey=reason SUBSEP user SUBSEP pkg SUBSEP olduid
        if (!(skey in seen)) {
            seen[skey]=1
            order[++count]=skey
            su[skey]=user
            sp[skey]=pkg
            suid[skey]=olduid
            sr[skey]=reason
        }
        nets[skey SUBSEP network]=1
    } else if (app_uid[k] != olduid) {
        reason="UID_CHANGED"
        stale++
        skey=reason SUBSEP user SUBSEP pkg SUBSEP olduid SUBSEP app_uid[k]
        if (!(skey in seen)) {
            seen[skey]=1
            order[++count]=skey
            su[skey]=user
            sp[skey]=pkg
            suid[skey]=olduid
            sn[skey]=app_name[k]
            sc[skey]=app_uid[k]
            sr[skey]=reason
        }
        nets[skey SUBSEP network]=1
    } else {
        valid++
    }
}
END {
    printf "{\"status\":\"OK\",\"summary\":{\"total_block_rules\":%d,\"valid\":%d,\"stale\":%d,\"stale_apps\":%d},\"stale_rules\":[", total, valid, stale, count
    for (i=1; i<=count; i++) {
        k=order[i]
        if (i>1) printf ","
        printf "{\"reason\":\"%s\",\"user\":\"%s\",\"pkg\":\"%s\",\"name\":\"%s\",\"uid\":\"%s\"", sr[k], esc(su[k]), esc(sp[k]), esc(sn[k]), esc(suid[k])
        if (sr[k]=="UID_CHANGED") printf ",\"current_uid\":\"%s\"", esc(sc[k])
        printf ",\"networks\":["
        first=1
        for (n in nets) {
            if (index(n, k SUBSEP)==1) {
                network=substr(n, length(k)+length(SUBSEP)+1)
                if (!first) printf ","
                printf "\"%s\"", esc(network)
                first=0
            }
        }
        printf "]}"
    }
    printf "]}\n"
}
' "$APPS" "$POLICY"
