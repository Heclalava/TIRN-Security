#!/system/bin/sh
MODDIR="/data/adb/modules/tirnsecurity"
DATA_DIR="/data/adb/tirnsecurity"
DEBUG_LOG="$DATA_DIR/debug.log"
umask 077
. "$MODDIR/logging-common.sh"
echo "Content-Type: application/json"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo "Pragma: no-cache"
echo "Expires: 0"
echo
if ! : > "$DEBUG_LOG" 2>/dev/null; then
    log_error "Logs" "Debug log clear failed" "debug.log"
    printf '%s\n' '{"status":"ERROR","error":"Unable to clear debug.log"}'
    exit 1
fi
printf '%s\n' '{"status":"OK","message":"debug.log cleared"}'
