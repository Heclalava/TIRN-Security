#!/system/bin/sh
echo "Content-Type: application/json"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo "Pragma: no-cache"
echo "Expires: 0"
echo
DATA_DIR="/data/adb/tirnsecurity"
POLICY="$DATA_DIR/policy.conf"
LOCK="$DATA_DIR/policy.lock"
LOCK_WAIT=0
while ! mkdir "$LOCK" 2>/dev/null; do
    sleep 0.05
    LOCK_WAIT=$((LOCK_WAIT + 1))
    if [ "$LOCK_WAIT" -ge 200 ]; then
        printf "{\"status\":\"ERROR\",\"error\":\"Policy busy\"}\n"
        exit 1
    fi
done
trap 'rmdir "$LOCK" 2>/dev/null' EXIT
TMP="$DATA_DIR/policy.clear.$$"
: > "$TMP" || { printf '{"status":"ERROR","error":"Cannot create policy"}\n'; exit 1; }
chmod 600 "$TMP"
mv -f "$TMP" "$POLICY" || { rm -f "$TMP"; printf '{"status":"ERROR","error":"Cannot clear policy"}\n'; exit 1; }
printf '{"status":"OK","message":"Policy cleared"}\n'
