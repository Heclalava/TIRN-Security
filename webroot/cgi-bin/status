#!/system/bin/sh
echo "Content-Type: application/json"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo "Pragma: no-cache"
echo "Expires: 0"
echo
IPT="/system/bin/iptables"
IP6T="/system/bin/ip6tables"
STATE="/data/adb/tirnsecurity/network.state"
ENGINE="OFF"
if "$IPT" -C OUTPUT -j TIRNFW >/dev/null 2>&1 && "$IP6T" -C OUTPUT -j TIRNFW >/dev/null 2>&1; then ENGINE="ON"; fi
W4=0
W6=0
MOBILE=0
if [ -f "$STATE" ]; then
    grep -q '^WLAN4|' "$STATE" && W4=1
    grep -q '^WLAN6|' "$STATE" && W6=1
    MOBILE=$(/system/bin/grep -c '^MOBILE|' "$STATE" 2>/dev/null)
fi
printf '{"status":"OK","engine":"%s","ipv4":%s,"ipv6":%s,"mobile_interfaces":%s}\n' "$ENGINE" "$W4" "$W6" "$MOBILE"
