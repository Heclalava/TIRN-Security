#!/system/bin/sh

echo "Content-Type: application/json"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo "Pragma: no-cache"
echo "Expires: 0"
echo

data_dir="/data/adb/tirnsecurity"
apps="$data_dir/apps.json"
body="$(cat)"
apps_json="$(cat "$apps" 2>/dev/null)"

if [ -z "$apps_json" ]; then
    printf '%s\n' '{"status":"ERROR","message":"Application cache is unavailable."}'
    exit 1
fi

sep='__TIRN_SECURITY_APPS_END_7f31c9__'

printf '%s\n%s\n%s\n' "$apps_json" "$sep" "$body" |
awk -v sep="$sep" '
function json_escape(s,    t){
    t=s
    gsub(/\\/, "\\\\", t)
    gsub(/"/, "\\\"", t)
    gsub(/\r/, "\\r", t)
    gsub(/\n/, "\\n", t)
    gsub(/\t/, "\\t", t)
    return t
}

function hexval(c){
    if(c>="0" && c<="9") return c+0
    if(c>="a" && c<="f") return 10 + index("abcdef",c)-1
    if(c>="A" && c<="F") return 10 + index("ABCDEF",c)-1
    return -1
}

function utf8(cp,    b){
    if(cp<128)
        return sprintf("%c",cp)
    if(cp<2048)
        return sprintf("%c%c",192+int(cp/64),128+(cp%64))
    if(cp<65536)
        return sprintf("%c%c%c",224+int(cp/4096),128+(int(cp/64)%64),128+(cp%64))
    return sprintf("%c%c%c%c",240+int(cp/262144),128+(int(cp/4096)%64),128+(int(cp/64)%64),128+(cp%64))
}

function json_unescape(s,    out,i,c,n,h,cp,lo,j){
    out=""
    i=1
    while(i<=length(s)){
        c=substr(s,i,1)
        if(c!="\\"){
            out=out c
            i++
            continue
        }

        if(i==length(s)){
            out=out c
            i++
            continue
        }

        c=substr(s,i+1,1)

        if(c=="u" && i+5<=length(s)){
            h=substr(s,i+2,4)
            cp=0
            n=0
            for(j=1;j<=4;j++){
                n=hexval(substr(h,j,1))
                if(n<0) break
                cp=cp*16+n
            }

            if(j==5){
                i+=6

                if(cp>=55296 && cp<=56319 && substr(s,i,2)=="\\u" && i+5<=length(s)){
                    h=substr(s,i+2,4)
                    lo=0
                    n=0
                    for(j=1;j<=4;j++){
                        n=hexval(substr(h,j,1))
                        if(n<0) break
                        lo=lo*16+n
                    }
                    if(j==5 && lo>=56320 && lo<=57343){
                        cp=65536+(cp-55296)*1024+(lo-56320)
                        i+=6
                    }
                }

                out=out utf8(cp)
                continue
            }
        }

        if(c=="n") out=out "\n"
        else if(c=="r") out=out "\r"
        else if(c=="t") out=out "\t"
        else if(c=="b") out=out sprintf("%c",8)
        else if(c=="f") out=out sprintf("%c",12)
        else out=out c

        i+=2
    }
    return out
}

function jval(o,k,    re,x){
    re="\"" k "\"[[:space:]]*:[[:space:]]*\"([^\"]*)\""
    if(match(o,re)){
        x=substr(o,RSTART,RLENGTH)
        sub("^[^:]*:[[:space:]]*\"", "", x)
        sub("\"$", "", x)
        return json_unescape(x)
    }
    return ""
}

function jbool(o,k,    re,x){
    re="\"" k "\"[[:space:]]*:[[:space:]]*(true|false)"
    if(match(o,re)){
        x=substr(o,RSTART,RLENGTH)
        sub("^[^:]*:[[:space:]]*", "", x)
        return x
    }
    return "false"
}

function process_app(o,    u,uid,pkg,name,sys,id){
    u=jval(o,"user")
    uid=jval(o,"uid")
    pkg=jval(o,"pkg")
    name=jval(o,"name")
    sys=jbool(o,"system")

    if(uid!="" && pkg!="" && u!=""){
        app_uid[u SUBSEP pkg]=uid
        app_name[u SUBSEP pkg]=name
        app_system[u SUBSEP pkg]=sys
        apps_seen++
    } else {
        id=jval(o,"id")
        if(id!="" && name!=""){
            profile_name[id]=name
            profiles_seen++
        }
    }
}

function scan_apps_char(c){
    if(inq){
        if(depth>1)obj=obj c
        if(escp)escp=0
        else if(c=="\\")escp=1
        else if(c=="\"")inq=0
        return
    }

    if(c=="\""){
        if(depth>1)obj=obj c
        inq=1
        return
    }

    if(c=="{"){
        if(depth==1)obj="{"
        else if(depth>1)obj=obj c
        depth++
        return
    }

    if(depth>0){
        if(depth>1)obj=obj c
        if(c=="}"){
            depth--
            if(depth==1){
                process_app(obj)
                obj=""
            }
        }
    }
}

function process_policy(o,    uid,network,action,user,pkg,name,profile,sys,key,current_uid,current_name,current_profile,euid,enetwork,eaction,euser,epkg,ename,eprofile,ecurrent_uid,ecurrent_name,ecurrent_profile){
    uid=jval(o,"uid")
    network=jval(o,"network")
    action=jval(o,"action")

    if(uid=="" && network=="" && action=="")
        return

    total++

    user=jval(o,"user")
    pkg=jval(o,"pkg")
    name=jval(o,"name")
    profile=jval(o,"profile")
    sys=jbool(o,"system")

    euid=json_escape(uid)
    enetwork=json_escape(network)
    eaction=json_escape(action)
    euser=json_escape(user)
    epkg=json_escape(pkg)
    ename=json_escape(name)
    eprofile=json_escape(profile)

    if(network!="LAN" && network!="MOBILE" && network!="WIFI"){
        stale++
        stale_count++
        stale_json=stale_json (stale_json?",":"") \
            "{\"reason\":\"INVALID_NETWORK\",\"uid\":\"" euid "\",\"network\":\"" enetwork "\",\"action\":\"" eaction "\",\"app\":{\"name\":\"" ename "\",\"pkg\":\"" epkg "\",\"user\":\"" euser "\",\"profile\":\"" eprofile "\",\"system\":" sys "}}"
        return
    }

    if(action!="BLOCK"){
        stale++
        stale_count++
        stale_json=stale_json (stale_json?",":"") \
            "{\"reason\":\"INVALID_ACTION\",\"uid\":\"" euid "\",\"network\":\"" enetwork "\",\"action\":\"" eaction "\",\"app\":{\"name\":\"" ename "\",\"pkg\":\"" epkg "\",\"user\":\"" euser "\",\"profile\":\"" eprofile "\",\"system\":" sys "}}"
        return
    }

    key=user SUBSEP pkg
    current_uid=app_uid[key]
    current_name=app_name[key]
    current_profile=profile_name[user]

    if(current_uid==""){
        stale++
        stale_count++
        stale_json=stale_json (stale_json?",":"") \
            "{\"reason\":\"APP_MISSING\",\"uid\":\"" euid "\",\"network\":\"" enetwork "\",\"action\":\"" eaction "\",\"app\":{\"name\":\"" ename "\",\"pkg\":\"" epkg "\",\"user\":\"" euser "\",\"profile\":\"" eprofile "\",\"system\":" sys "}}"
        return
    }

    if(current_uid!=uid){
        ecurrent_uid=json_escape(current_uid)
        ecurrent_name=json_escape(current_name)
        ecurrent_profile=json_escape(current_profile)

        stale++
        stale_count++
        uid_mismatch++
        stale_json=stale_json (stale_json?",":"") \
            "{\"reason\":\"UID_CHANGED\",\"uid\":\"" euid "\",\"network\":\"" enetwork "\",\"action\":\"" eaction "\",\"app\":{\"name\":\"" ename "\",\"pkg\":\"" epkg "\",\"user\":\"" euser "\",\"profile\":\"" eprofile "\",\"system\":" sys "},\"current\":{\"uid\":\"" ecurrent_uid "\",\"name\":\"" ecurrent_name "\",\"profile\":\"" ecurrent_profile "\"}}"
        return
    }

    valid++

    rule_prefix=(rules_json?",":"")
    rule_item="{\"user\":\"" euser "\",\"pkg\":\"" epkg "\",\"uid\":\"" euid "\",\"network\":\"" enetwork "\",\"action\":\"" eaction "\"}"
    rules_json=rules_json rule_prefix rule_item
}

function scan_policy_char(c){
    if(inq){
        if(depth>1)obj=obj c
        if(escp)escp=0
        else if(c=="\\")escp=1
        else if(c=="\"")inq=0
        return
    }

    if(c=="\""){
        if(depth>1)obj=obj c
        inq=1
        return
    }

    if(c=="{"){
        if(depth==1)obj="{"
        else if(depth>1)obj=obj c
        depth++
        return
    }

    if(depth>0){
        if(depth>1)obj=obj c
        if(c=="}"){
            depth--
            if(depth==1){
                process_policy(obj)
                obj=""
            }
        }
    }
}

{
    if($0==sep){
        phase=1
        next
    }

    if(phase==0){
        for(i=1;i<=length($0);i++)
            scan_apps_char(substr($0,i,1))
    } else {
        for(i=1;i<=length($0);i++)
            scan_policy_char(substr($0,i,1))
    }
}

END{
    if(!profiles_seen || !apps_seen){
        print "{\"status\":\"ERROR\",\"message\":\"Application cache is invalid or incomplete.\"}"
        exit
    }

    if(!total){
        print "{\"status\":\"ERROR\",\"message\":\"No policy records were found in the import file.\"}"
        exit
    }

    msg=(stale_count ? "Stale rules were skipped because the application is no longer installed or the UID changed." : "Import validation successful.")

    printf "{\"status\":\"OK\",\"summary\":{\"total\":\"%d\",\"valid\":\"%d\",\"stale\":\"%d\",\"stale_count\":\"%d\",\"uid_mismatch\":\"%d\"},\"message\":\"%s\",\"stale_rules\":[%s],\"rules\":[%s]}\n", \
        total,valid,stale,stale_count,uid_mismatch,msg,stale_json,rules_json
}
'
