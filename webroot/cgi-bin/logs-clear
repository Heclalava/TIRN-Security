#!/system/bin/sh

MODDIR="/data/adb/modules/tirnsecurity"
DATA_DIR="/data/adb/tirnsecurity"
SERVICE_LOG="$DATA_DIR/service.log"
DEBUG_LOG="$DATA_DIR/debug.log"

umask 077

. "$MODDIR/logging-common.sh"

echo "Content-Type: application/json"
echo "Cache-Control: no-store, no-cache, must-revalidate, max-age=0"
echo "Pragma: no-cache"
echo "Expires: 0"
echo

FAILURES=""

if ! : > "$SERVICE_LOG" 2>/dev/null; then
    FAILURES="service.log"
fi

if ! : > "$DEBUG_LOG" 2>/dev/null; then
    if [ -n "$FAILURES" ]; then
        FAILURES="$FAILURES debug.log"
    else
        FAILURES="debug.log"
    fi
fi

if [ -n "$FAILURES" ]; then
    log_error "Logs" "Clear failed" "$FAILURES"
    printf '{"status":"ERROR","error":"Unable to clear: %s"}\n' "$FAILURES"
    exit 1
fi

printf '{"status":"OK","message":"Logs cleared"}\n'
