      ? "UID "+item.uid+" → "+item.currentUid
      : "UID "+item.uid;

    const networks=item.networks.length
      ? " · Networks: "+item.networks.join(", ")
      : "";

    const packageLabel=item.pkg
      ? " · Package: "+item.pkg
      : "";

    const reasonLabel=item.reason==="UID_CHANGED"
      ? "App UID has changed"
      : item.reason==="APP_MISSING"
        ? "App is not installed"
        : item.reason;

    const stateLabel=item.state==="accepted"
      ? " · Accepted & reassigned"
      : item.state==="rejected"
        ? " · Rejected"
        : " · "+reasonLabel;

    detail.textContent=
      userLabel+
