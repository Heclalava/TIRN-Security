}

async function importBackup(file){
  setTaskStatus("IMPORTING");
  if(!file)return;

  try{
    const text=await file.text();
    const d=JSON.parse(text);

    if(
      d.type!=="TIRN Security"||
      !Array.isArray(d.policy)
    ){
      throw new Error("Invalid backup");
    }

    if(writeBusy){
      toast("Policy update in progress");
      return;
    }

    if(hasPendingPolicyChanges()){
      toast("Apply pending policy changes first");
      return;
    }

    staleImportItems=[];
    staleImportCandidate=new Map();
    staleImportBusy=false;
    staleImportCommitStarted=false;
    staleImportMode="import";

    writeBusy=true;
    showImportProcessingModal(
      "Applying policy changes",
      "Validating and preparing the imported firewall policy."
    );

    const validation=await api("/policy-import",{
      method:"POST",
      headers:{
        "Content-Type":"application/json"
      },
      body:text
    });

    const next=new Map();

    if(Array.isArray(validation.rules)){
      validation.rules.forEach(x=>{
        next.set(
          String(x.user)+"|"+
          String(x.pkg)+"|"+
          String(x.uid)+"|"+
          x.network+"|"+
          String(x.action||"BLOCK"),
          true
        );
      });
    }

    staleImportCandidate=new Map(next);

    const summary=validation.summary||{};
    const total=Number(summary.total||0);
    const valid=Number(summary.valid||0);
    const stale=Number(summary.stale||0);
    const mismatch=Number(summary.uid_mismatch||0);

    if(Array.isArray(validation.stale_rules) &&
       validation.stale_rules.length){

      staleImportItems=buildStaleImportItems(
        validation.stale_rules
      ).map(item=>({
        ...item,
        state:"pending"
      }));

      hideImportProcessingModal();
      setTaskStatus("IMPORTING");
      showStaleImportModal(validation.stale_rules);
      return;
    }

    await commitImportedPolicy(next);
    applyImportedPolicy(next);

    hideImportProcessingModal();
    setTaskStatus("READY");

    writeBusy=false;

    try{
      await scanStaleRules(false);
    }catch(e){
      console.error(
        "TIRN Security post-import stale scan failed:",
        e
      );
    }

    toast("Policy imported");
    showImportCompleteModal(valid);

  }catch(e){
    console.error("TIRN Security policy import failed:",e);

    hideImportProcessingModal();
    setTaskStatus("ERROR");

    await loadPolicy().catch(()=>{});
    policySignature=getPolicySignature();
    render();

    toast("Import failed");
  }finally{
    if(!staleImportItems.some(x=>x.state==="pending")){
      writeBusy=false;
    }

    document.getElementById("importFile").value="";
  }
}

let staleImportItems=[];
let staleImportBusy=false;
let staleImportCandidate=new Map();
let staleImportCommitStarted=false;
let staleImportMode="import";

function buildStaleImportItems(staleRules){
  const grouped=new Map();

  staleRules.forEach(x=>{
    const app=x.app||{};
    const current=x.current||{};
    const key=
      String(app.user||"")+
      "|"+
      String(app.pkg||"")+
      "|"+
      String(x.uid||"");

    if(!grouped.has(key)){
      grouped.set(key,{
        key:key,
        user:String(app.user||""),
        profile:String(app.profile||""),
        name:String(app.name||app.pkg||""),
        pkg:String(app.pkg||""),
        uid:String(x.uid||""),
        currentUid:String(current.uid||""),
        currentName:String(current.name||""),
        currentProfile:String(current.profile||""),
        reason:String(x.reason||"APP_MISSING"),
        networks:[],
        acceptedNetworks:[]
      });
    }

    const item=grouped.get(key);
    const network=String(x.network||"");

    if(network && !item.networks.includes(network)){
      item.networks.push(network);
    }
  });

  return Array.from(grouped.values());
}

function staleImportCounts(){
  let accepted=0;
  let rejected=0;
  let remaining=0;

  staleImportItems.forEach(item=>{
    if(item.state==="accepted")accepted++;
    else if(item.state==="rejected")rejected++;
    else remaining++;
  });

  return{
    total:staleImportItems.length,
    accepted:accepted,
    rejected:rejected,
    remaining:remaining
  };
}

