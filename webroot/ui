async function confirmClearLogs(){
  const title=document.getElementById("clearLogsTitle");
  const message=document.getElementById("clearLogsMessage");
  const error=document.getElementById("clearLogsError");
  const confirm=document.getElementById("clearLogsConfirm");
  const cancel=document.getElementById("clearLogsCancel");
  const close=document.getElementById("clearLogsClose");
  const label=clearLogTarget==="debug"?"debug.log":"service.log";

  confirm.disabled=true;
  cancel.disabled=true;
  confirm.style.display="none";
  cancel.style.display="none";
  close.style.display="none";
  title.textContent="Clearing "+label+"…";
  message.textContent="Clearing "+label+"…";
  error.textContent="";
  setTaskStatus("CLEARING LOG");

  try{
    await api(clearLogTarget==="debug"?"/logs-clear-debug":"/logs-clear-system");
    title.textContent=label+" cleared";
    message.textContent="TIRN Security "+label+" was cleared successfully.";
    error.textContent="";
  }catch(e){
    title.textContent="Failed to clear "+label;
    message.textContent="TIRN Security could not clear "+label+".";
    error.textContent=e.message||"Unknown error";
  }finally{
    setTaskStatus("READY");
    close.style.display="";
  }
}

async function confirmClearAll(){
  hideClearConfirm();

  if(writeBusy){
    toast("Policy update in progress");
    return;
  }

  if(!policy.size){
    updatePendingBar();
    return;
  }

  policyRequestGeneration++;
  policy.clear();

  updateRuleCount();
  policySignature=getPolicySignature();
  updatePendingBar();
  render();

  toast("Policy cleared. Press APPLY RULES to activate.");
}

async function init(){
  try{
    await loadPolicy();
    await scanStaleRules();
    await loadApps();
    await refreshAppRevision(true);
    await readNetwork();
    await readEngine();
    render();
  }catch(e){
    console.error("TIRN Security init failed:",e);
    document.getElementById("list").innerHTML=
      '<div class="empty">'+String(e)+'</div>';
    toast("TIRN Security CGI unavailable");
  }
}

let policyRefreshBusy=false;
let policySignature="";
let appRevisionBusy=false;
let appRevision="";

function getPolicySignature(){
  return Array.from(policy.keys()).sort().join("\n");
}

async function refreshAppRevision(force=false){
  if(appRevisionBusy || writeBusy || document.visibilityState!=="visible") return;
  appRevisionBusy=true;
  try{
    const data=await api("/apps-revision");
    if(!data || data.status==="ERROR" || data.revision===undefined) return;

    const revision=String(data.revision);

    if(force){
      appRevision=revision;
      return;
    }

    if(appRevision!==revision){
      appRevision=revision;
      await loadApps();
      render();
    }
  }catch(e){
    console.error("TIRN Security app revision check failed:",e);
  }finally{
    appRevisionBusy=false;
  }
}

async function refreshPolicy(force=false){
  if(
    policyRefreshBusy ||
    writeBusy ||
    hasPendingPolicyChanges() ||
    document.visibilityState!=="visible"
  ) return;
  policyRefreshBusy=true;
  try{
    const before=policySignature;
    await loadPolicy();
    const after=getPolicySignature();
    if(force || after!==before){
      policySignature=after;
      render();
    }
  }catch(e){
    console.error("TIRN Security policy refresh failed:",e);
  }finally{
    policyRefreshBusy=false;
  }
}

window.addEventListener("pageshow",()=>{
  refreshPolicy(true);
});
window.addEventListener("focus",()=>{
  refreshPolicy(true);
});

setInterval(()=>{
  refreshPolicy(false);
  refreshAppRevision(false);
},10000);

init();
</script>
