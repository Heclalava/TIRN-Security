<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#282828"/>
<link rel="manifest" href="/manifest.json"/>
<title>TIRN Security</title>
<style>
:root{
  --bg:#282828;--panel:#32302f;--panel2:#3c3836;--line:#504945;
  --text:#ebdbb2;--muted:#a89984;--green:#b8bb26;--red:#fb4934;
  --yellow:#fabd2f;--blue:#83a598;--orange:#fe8019;--engine-green:#8ec07c;--allow-green:#8ec07c;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--text);font-family:"Ubuntu Condensed","Arial Narrow",sans-serif;font-size:14px;height:100%;overflow:hidden}
body{padding-bottom:env(safe-area-inset-bottom);display:flex;flex-direction:column;height:100%;overflow:hidden}
button,input{font:inherit}
button{color:inherit}
.header{
  flex:none;
  position:relative;
  z-index:50;
  margin:0 8px 6px;
  background:var(--panel);
  border:1px solid var(--line);
  border-top:0;
  border-radius:0 0 10px 10px;
  padding:10px 12px 8px;
  padding-top:max(10px,env(safe-area-inset-top));
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 3px 8px rgba(0,0,0,.45);
}
.header-row{display:flex;align-items:center;justify-content:space-between;gap:10px}.header-row>div:first-child{min-width:0}
.brand{font-size:22px;font-weight:700;letter-spacing:.02em}
.brand-dot{color:var(--green)}
.header-actions{display:flex;gap:6px;flex:none}
.main-menu{
  display:none;
  position:absolute;
  top:calc(100% - 1px);
  right:0;
  width:min(220px,calc(100vw - 24px));
  padding:6px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:0 0 9px 9px;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 5px 12px rgba(0,0,0,.55);
  z-index:60;
}
.main-menu.show{display:block}
.main-menu .menu-separator{height:1px;margin:6px 4px;background:var(--line);opacity:1}
.main-menu button{
  display:block;
  width:100%;
  min-height:38px;
  padding:7px 10px;
  border:0;
  border-radius:6px;
  background:transparent;
  color:var(--text);
  text-align:left;
  font-size:14px;
}
.main-menu button:active{
  background:var(--panel2);
}
.main-menu button.danger{
  color:var(--red);
}
.icon-btn,.small-btn{
  border:1px solid var(--line);
  background:var(--panel);
  border-radius:8px;
  min-height:34px;
  padding:0 9px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.icon-btn{
  width:34px;
  padding:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  line-height:1;
}
.icon-btn:active,
.small-btn:active,
.filter:active,
.cell:active{
  opacity:1;
  transform:translateY(1px);
  box-shadow:
    inset 1px 2px 3px rgba(0,0,0,.35);
}
.statusline{display:flex;gap:9px;flex-wrap:nowrap;white-space:nowrap;margin-top:3px;color:var(--muted);font-size:12px}
.statusline b{
  font-weight:700;
  color:var(--muted);
}
.statusline b.blocked-count{
  color:var(--red);
}
.statusline .ok{color:var(--engine-green)!important}.statusline .bad{color:var(--red)!important}.statusline .warn{color:var(--yellow)!important}.statusline #taskStatus{color:#C5C898!important}.statusline #blockedLabel{color:var(--text)}
.toolbar{
  flex:none;
  margin:0 8px 7px;
  padding:8px 8px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 3px 8px rgba(0,0,0,.45);
}
.filters{display:flex;gap:5px;overflow:auto}
.filter{
  flex:1;
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--muted);
  border-radius:7px;
  min-height:32px;
  font-weight:700;
  font-size:13px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.filter.active{
  background:var(--orange);
  border-color:var(--orange);
  color:#282828;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.18),
    inset -1px -1px 3px rgba(0,0,0,.35),
    0 2px 4px rgba(0,0,0,.35);
}
.select-row{display:flex;gap:6px;margin-top:6px}
.select{
  flex:1;
  min-width:0;
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--text);
  border-radius:8px;
  height:34px;
  padding:0 10px;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 3px 8px rgba(0,0,0,.45);
}

.select option{
  background:var(--panel);
  color:var(--text);
}

.custom-select{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:space-between;
  cursor:pointer;
}

.select-arrow{
  color:var(--muted);
  font-size:11px;
}

.profile-menu{
  display:none;
  position:absolute;
  left:0;
  right:0;
  top:40px;
  z-index:80;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 4px 10px rgba(0,0,0,.55);
}

.profile-menu.show{
  display:block;
}

.profile-item{
  padding:8px 10px;
  color:var(--text);
  font-size:13px;
}

.profile-item:hover,
.profile-item.active{
  background:rgba(235,219,178,.08);
}
.search{margin-top:6px;position:relative}
.search input{
  width:100%;
  height:34px;
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--text);
  border-radius:7px;
  padding:0 10px 0 31px;
  outline:none;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.search input:focus{
  border-color:var(--orange);
}
.search::before{content:"⌕";position:absolute;left:10px;top:4px;color:var(--muted);font-size:21px;z-index:1}
.bulk{
  margin-top:7px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:8px;
  padding:6px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.bulk-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px}
.network-row{
  display:grid;
  grid-template-columns:1fr 74px 74px;
  gap:6px;
  align-items:center;
  margin-bottom:5px;
}
.network-row:last-child{margin-bottom:0}
.network-row span{
  font-size:12px;
  font-weight:700;
  color:var(--text);
}
.bulk button{
  height:30px;
  border:1px solid var(--line);
  background:linear-gradient(#45403d,#32302f);
  border-radius:7px;
  font-weight:700;
  font-size:11px;
  box-shadow:inset 0 1px rgba(255,255,255,.08),0 1px 2px rgba(0,0,0,.4);

  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.bulk button:active{
  transform:translateY(1px);
  box-shadow:inset 0 2px rgba(0,0,0,.25);
}
.bulk button.block{color:var(--red)}
.bulk button.allow{color:var(--allow-green)}
.list-wrapper{
  flex:1;
  min-height:0;
  margin:0 8px 12px;
  display:flex;
  flex-direction:column;
}

.list{
  margin:0;
  border:1px solid var(--line);
  border-top:0;
  border-radius:0;
  background:var(--panel);
  overflow:hidden;
  flex:1;
  min-height:0;
  display:flex;
  flex-direction:column;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px 0 3px rgba(0,0,0,.45),
    0 3px 8px rgba(0,0,0,.45);
}

.pending-bar{
  position:relative;
  z-index:2;
  flex:none;
  min-height:36px;
  margin:0;
  padding:5px 7px;
  border:1px solid var(--line);
  border-top:1px solid rgba(0,0,0,.45);
  border-radius:0 0 10px 10px;
  background:#282927;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px 0 2px rgba(0,0,0,.35),
    0 3px 8px rgba(0,0,0,.45);
}

.pending-bar span,
.pending-bar button{
  position:relative;
  z-index:1;
}

.pending-bar span{
  min-width:0;
  color:var(--muted);
  font-size:11px;
  line-height:1.15;
}

.pending-bar button{
  flex:none;
  min-width:94px;
  min-height:26px;
  padding:0 9px;
  border:1px solid var(--line);
  border-radius:6px;
  background:linear-gradient(
    to bottom,
    rgba(235,219,178,.055),
    rgba(60,56,54,.18)
  );
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 2px rgba(0,0,0,.42),
    0 2px 4px rgba(0,0,0,.35);
  color:var(--text);
  font-size:10px;
  font-weight:700;
  letter-spacing:.03em;
  cursor:pointer;
}

.pending-bar button:active{
  background:var(--panel2);
  box-shadow:
    inset 1px 1px 2px rgba(0,0,0,.32),
    inset -1px -1px 2px rgba(255,255,255,.025);
}

.pending-bar button:disabled{
  opacity:.45;
  cursor:default;
}

.matrix-head,.app-row{
  display:grid;
  grid-template-columns:minmax(0,1fr) 54px 54px 54px;
  align-items:center;
}

.matrix-head{
  position:static;
  flex:none;
  min-height:30px;
  background:linear-gradient(
    to bottom,
    rgba(235,219,178,.035),
    rgba(60,56,54,.15)
  );
  border:1px solid var(--line);
  border-bottom:1px solid var(--line);
  border-radius:10px 10px 0 0;
  color:var(--muted);
  font-size:11px;
  font-weight:700;
  text-align:center;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px 0 2px rgba(0,0,0,.35),
    0 3px 8px rgba(0,0,0,.45);
}
.matrix-head .apphead{text-align:left;padding-left:9px;display:flex;align-items:center;gap:6px}.refresh-apps-list{flex:none;width:18px;height:18px;box-sizing:border-box;padding:3%;border:1px solid var(--line);border-radius:5px;background:linear-gradient(to bottom,rgba(235,219,178,.04),rgba(60,56,54,.16));box-shadow:inset 1px 1px 1px rgba(255,255,255,.035),inset -1px -1px 1px rgba(0,0,0,.28),0 1px 2px rgba(0,0,0,.2);color:var(--text);font-size:17px;font-weight:600;letter-spacing:0;line-height:1;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center}.refresh-apps-list:active{background:var(--panel2);box-shadow:inset 1px 1px 1px rgba(0,0,0,.32),inset -1px -1px 1px rgba(255,255,255,.025)}
#appRows{
  flex:1;
  min-height:0;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior:contain;
}
.app-row{
  min-height:48px;
  border-bottom:1px solid rgba(235,219,178,.08);
  background:rgba(60,56,54,.18);
  transition:.15s ease;
}

.app-row:hover{
  background:rgba(235,219,178,.04);
}

.app-row:last-child{
  border-bottom:1px solid rgba(235,219,178,.08);
}

.app-info{
  min-width:0;
  flex:1;
  padding:5px 4px 5px 9px;
}

.app-top{
  display:block;
  min-width:0;
}

.app-name{
  font-size:14px;
  font-weight:700;
  color:var(--text);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.meta{
  font-size:10px;
  color:var(--muted);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  margin-top:2px;
}

.profile{
  color:var(--blue);
}

.cell{
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  border-left:1px solid rgba(235,219,178,.08);
  cursor:pointer;
}
.cell input{position:absolute;opacity:0;pointer-events:none}
.dot{
  width:18px;
  overflow:hidden;
  text-indent:-9999px;
  height:18px;
  border-radius:6px;
  border:1px solid var(--line);
  background:var(--panel);
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 1px 2px rgba(0,0,0,.35);
  transition:.15s ease;
}

.cell input:checked + .dot{
  background:rgba(251,73,52,.10);
  border-color:rgba(251,73,52,.55);
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 0 4px rgba(251,73,52,.35);
}
.app-row.changed{background:rgba(254,128,25,.04)}
.legend{
  flex:none;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:10px;
  padding:5px 9px;
  padding-bottom:calc(5px + env(safe-area-inset-bottom));
  color:var(--muted);
  font-size:11px;
}
.legend span{
  display:flex;
  align-items:center;
  gap:5px;
}
.legend i{
  width:12px;
  height:12px;
  border-radius:4px;
  border:1px solid var(--line);
  background:var(--panel);
  display:inline-block;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 1px 2px rgba(0,0,0,.35);
}
.legend i.blocked{
  background:rgba(251,73,52,.10);
  border-color:rgba(251,73,52,.55);
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 0 4px rgba(251,73,52,.35);
}
.legend i.allow{
  background:var(--panel);
  border-color:var(--line);
}
.empty,.loading{padding:30px 12px;text-align:center;color:var(--muted)}
.footer{
  flex:none;
  padding:3px 6px;
  padding-bottom:calc(5px + env(safe-area-inset-bottom));
  color:var(--muted);
  font-size:11px;
  text-align:center;
  white-space:nowrap;
  opacity:.85;
}
.toast{
  position:fixed;
  left:50%;
  bottom:20px;
  transform:translate(-50%,20px);
  opacity:0;
  pointer-events:none;
  background:#282927;
  border:1px solid var(--line);
  border-radius:8px;
  padding:8px 12px;
  z-index:100;
  color:var(--text);
  font-size:11px;
  line-height:1.2;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 2px rgba(0,0,0,.42),
    0 3px 8px rgba(0,0,0,.45);
  transition:opacity .18s,transform .18s;
}

.toast.show{
  opacity:1;
  transform:translate(-50%,0);
}
.modal-back{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  display:none;
  align-items:center;
  justify-content:center;
  padding:16px;
  z-index:100;
}

.modal-back.show{
  display:flex;
}

.stale-import-rule{
  margin:12px 0;
  padding:10px 12px;
  border:1px solid var(--border);
  border-radius:8px;
  box-shadow:0 2px 5px rgba(0,0,0,.22);
}
.stale-import-rule-title{
  font-weight:600;
}
.stale-import-rule-detail{
  margin-top:4px;
}
.modal{
  width:100%;
  max-width:420px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  padding:14px;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 6px 14px rgba(0,0,0,.6);
}
.bulk-progress-modal{max-width:360px;padding:13px}.bulk-progress-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.bulk-progress-head h2{margin:0;font-size:17px}.bulk-progress-state{font-size:11px;font-weight:700;color:var(--muted);white-space:nowrap}.bulk-progress-state.ok{color:var(--engine-green)}.bulk-progress-state.err{color:var(--red)}.bulk-progress-track{height:8px;margin:12px 0 7px;background:var(--bg);border:1px solid var(--line);border-radius:5px;overflow:hidden;box-shadow:inset 1px 1px 3px rgba(0,0,0,.55)}.bulk-progress-bar{width:0;height:100%;background:var(--engine-green);border-radius:4px;box-shadow:0 0 5px rgba(142,192,124,.28);transition:width .12s ease}.bulk-progress-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:11px;margin-bottom:10px}.bulk-progress-error{display:none;color:var(--red);font-size:11px;line-height:1.35;margin:0 0 10px}.bulk-progress-error.show{display:block}.bulk-progress-modal button:disabled{opacity:.45;cursor:default}

.modal h2{
  font-size:18px;
  margin:0 0 8px;
}

.modal p{
  color:var(--muted);
  font-size:12px;
  line-height:1.35;
}

.modal button{
  width:100%;
  height:38px;
  margin-top:6px;
  border:1px solid var(--line);
  background:var(--panel2);
  border-radius:7px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}

.modal .danger{
  color:var(--red);
}

.status-btn{
  appearance:none;
  border:0;
  padding:0;
  margin:0;
  background:none;
  color:var(--muted);
  font:inherit;
  cursor:pointer;
}
.status-btn:hover{
  color:var(--text);
}
.status-btn.stale{
  color:var(--red);
  font-weight:700;
}
.status-btn:disabled{
  color:var(--muted);
  cursor:default;
}
 .stale-scan-loading{display:flex;align-items:center;gap:4px}.stale-scan-dots{display:inline-flex;gap:3px}.stale-scan-dots i{width:4px;height:4px;border-radius:50%;background:currentColor;opacity:.25;animation:staleScanDot 1.2s infinite ease-in-out}.stale-scan-dots i:nth-child(2){animation-delay:.15s}.stale-scan-dots i:nth-child(3){animation-delay:.3s}@keyframes staleScanDot{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:1;transform:translateY(-2px)}}
.stale-audit-modal{
  width:min(620px,calc(100vw - 28px));
  max-height:calc(100vh - 28px);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}
.stale-audit-head{
  flex:0 0 auto;
}
.stale-audit-summary{
  color:var(--muted);
  font-size:12px;
  line-height:1.4;
}
.stale-audit-rules{
  flex:1 1 auto;
  min-height:0;
  overflow-y:auto;
  overscroll-behavior:contain;
  border-top:1px solid rgba(128,128,128,.2);
  border-bottom:1px solid rgba(128,128,128,.2);
  margin:10px 0;
  padding:4px 0;
}
.stale-audit-rule{
  padding:12px 0;
  border-bottom:1px solid rgba(128,128,128,.16);
}
.stale-audit-rule:last-child{
  border-bottom:0;
}
.stale-audit-rule-title{
  font-weight:600;
  margin-bottom:4px;
}
.stale-audit-rule-detail{
  font-size:13px;
  line-height:1.45;
  opacity:.82;
  overflow-wrap:anywhere;
}
.stale-audit-actions{
  flex:0 0 auto;
  display:flex;
  justify-content:flex-end;
  gap:8px;
  flex-wrap:wrap;
  padding-top:4px;
}
.stale-audit-actions button{
  min-width:110px;
}
.stale-import-modal{
  width:min(620px,calc(100vw - 28px));
  max-height:calc(100vh - 28px);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}

.stale-import-head{
  flex:0 0 auto;
}

.stale-import-rules{
  flex:1 1 auto;
  min-height:0;
  overflow-y:auto;
  overscroll-behavior:contain;
  border-top:1px solid rgba(128,128,128,.2);
