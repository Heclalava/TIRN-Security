<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#282828"/>
<link rel="manifest" href="/manifest.json"/>
<title>TIRN Security</title>
<style>
:root{
  --bg:#282828;--panel:#32302f;--panel2:#3c3836;--line:#504945;
  --text:#ebdbb2;--muted:#a89984;--green:#b8bb26;--red:#fb4934;
  --yellow:#fabd2f;--blue:#83a598;--orange:#fe8019;--engine-green:#8ec07c;--allow-green:#8ec07c;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--text);font-family:"Ubuntu Condensed","Arial Narrow",sans-serif;font-size:14px;height:100%;overflow:hidden}
body{padding-bottom:env(safe-area-inset-bottom);display:flex;flex-direction:column;height:100%;overflow:hidden}
button,input{font:inherit}
button{color:inherit}
.header{
  flex:none;
  position:relative;
  z-index:50;
  margin:0 8px 6px;
  background:var(--panel);
  border:1px solid var(--line);
  border-top:0;
  border-radius:0 0 10px 10px;
  padding:10px 12px 8px;
  padding-top:max(10px,env(safe-area-inset-top));
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 3px 8px rgba(0,0,0,.45);
}
.header-row{display:flex;align-items:center;justify-content:space-between;gap:10px}.header-row>div:first-child{min-width:0}
.brand{font-size:22px;font-weight:700;letter-spacing:.02em}
.brand-dot{color:var(--green)}
.header-actions{display:flex;gap:6px;flex:none}
.icon-btn,.small-btn{
  border:1px solid var(--line);
  background:var(--panel);
  border-radius:8px;
  min-height:34px;
  padding:0 9px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.icon-btn{
  width:34px;
  padding:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  line-height:1;
}
.icon-btn.backup{
  font-size:16px;
}

.icon-btn.refresh{
  font-size:27px;
  transform:translateY(-1px);
}
.icon-btn:active,
.small-btn:active,
.filter:active,
.cell:active{
  opacity:1;
  transform:translateY(1px);
  box-shadow:
    inset 1px 2px 3px rgba(0,0,0,.35);
}
.statusline{display:flex;gap:9px;flex-wrap:nowrap;white-space:nowrap;margin-top:3px;color:var(--muted);font-size:12px}
.statusline b{
  font-weight:700;
  color:var(--muted);
}
.statusline b.blocked-count{
  color:var(--red);
}
.statusline .ok{color:var(--engine-green)!important}.statusline .bad{color:var(--red)!important}.statusline .warn{color:var(--yellow)!important}
.toolbar{
  flex:none;
  margin:0 8px 7px;
  padding:8px 8px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 3px 8px rgba(0,0,0,.45);
}
.filters{display:flex;gap:5px;overflow:auto}
.filter{
  flex:1;
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--muted);
  border-radius:7px;
  min-height:32px;
  font-weight:700;
  font-size:13px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.filter.active{
  background:var(--orange);
  border-color:var(--orange);
  color:#282828;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.18),
    inset -1px -1px 3px rgba(0,0,0,.35),
    0 2px 4px rgba(0,0,0,.35);
}
.select-row{display:flex;gap:6px;margin-top:6px}
.select{
  flex:1;
  min-width:0;
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--text);
  border-radius:8px;
  height:34px;
  padding:0 10px;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 3px 8px rgba(0,0,0,.45);
}

.select option{
  background:var(--panel);
  color:var(--text);
}

.custom-select{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:space-between;
  cursor:pointer;
}

.select-arrow{
  color:var(--muted);
  font-size:11px;
}

.profile-menu{
  display:none;
  position:absolute;
  left:0;
  right:0;
  top:40px;
  z-index:80;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 4px 10px rgba(0,0,0,.55);
}

.profile-menu.show{
  display:block;
}

.profile-item{
  padding:8px 10px;
  color:var(--text);
  font-size:13px;
}

.profile-item:hover,
.profile-item.active{
  background:rgba(235,219,178,.08);
}
.search{margin-top:6px;position:relative}
.search input{
  width:100%;
  height:34px;
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--text);
  border-radius:7px;
  padding:0 10px 0 31px;
  outline:none;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.search input:focus{
  border-color:var(--orange);
}
.search::before{content:"⌕";position:absolute;left:10px;top:4px;color:var(--muted);font-size:21px;z-index:1}
.bulk{
  margin-top:7px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:8px;
  padding:6px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.bulk-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px}
.network-row{
  display:grid;
  grid-template-columns:1fr 74px 74px;
  gap:6px;
  align-items:center;
  margin-bottom:5px;
}
.network-row:last-child{margin-bottom:0}
.network-row span{
  font-size:12px;
  font-weight:700;
  color:var(--text);
}
.bulk button{
  height:30px;
  border:1px solid var(--line);
  background:linear-gradient(#45403d,#32302f);
  border-radius:7px;
  font-weight:700;
  font-size:11px;
  box-shadow:inset 0 1px rgba(255,255,255,.08),0 1px 2px rgba(0,0,0,.4);

  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}
.bulk button:active{
  transform:translateY(1px);
  box-shadow:inset 0 2px rgba(0,0,0,.25);
}
.bulk button.block{color:var(--red)}
.bulk button.allow{color:var(--allow-green)}
.list-wrapper{
  flex:1;
  min-height:0;
  margin:0 8px 12px;
  display:flex;
  flex-direction:column;
}

.list{
  margin:0;
  border:1px solid var(--line);
  border-top:0;
  border-radius:0 0 10px 10px;
  background:var(--panel);
  overflow:hidden;
  flex:1;
  min-height:0;
  display:flex;
  flex-direction:column;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 3px 8px rgba(0,0,0,.45);
}

.matrix-head,.app-row{
  display:grid;
  grid-template-columns:minmax(0,1fr) 54px 54px 54px;
  align-items:center;
}

.matrix-head{
  position:static;
  flex:none;
  min-height:30px;
  background:linear-gradient(
    to bottom,
    rgba(235,219,178,.035),
    rgba(60,56,54,.15)
  );
  border:1px solid var(--line);
  border-bottom:1px solid var(--line);
  border-radius:10px 10px 0 0;
  color:var(--muted);
  font-size:11px;
  font-weight:700;
  text-align:center;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px 0 2px rgba(0,0,0,.35);
}
.matrix-head .apphead{text-align:left;padding-left:9px}
#appRows{
  flex:1;
  min-height:0;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior:contain;
}
.app-row{
  min-height:48px;
  border-bottom:1px solid rgba(235,219,178,.08);
  background:rgba(60,56,54,.18);
  transition:.15s ease;
}

.app-row:hover{
  background:rgba(235,219,178,.04);
}

.app-row:last-child{
  border-bottom:1px solid rgba(235,219,178,.08);
}

.app-info{
  min-width:0;
  flex:1;
  padding:5px 4px 5px 9px;
}

.app-top{
  display:block;
  min-width:0;
}

.app-name{
  font-size:14px;
  font-weight:700;
  color:var(--text);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.meta{
  font-size:10px;
  color:var(--muted);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  margin-top:2px;
}

.profile{
  color:var(--blue);
}

.cell{
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  border-left:1px solid rgba(235,219,178,.08);
  cursor:pointer;
}
.cell input{position:absolute;opacity:0;pointer-events:none}
.dot{
  width:18px;
  overflow:hidden;
  text-indent:-9999px;
  height:18px;
  border-radius:6px;
  border:1px solid var(--line);
  background:var(--panel);
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 1px 2px rgba(0,0,0,.35);
  transition:.15s ease;
}

.cell input:checked + .dot{
  background:rgba(251,73,52,.10);
  border-color:rgba(251,73,52,.55);
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 0 4px rgba(251,73,52,.35);
}
.app-row.changed{background:rgba(254,128,25,.04)}
.legend{
  flex:none;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:10px;
  padding:5px 9px;
  padding-bottom:calc(5px + env(safe-area-inset-bottom));
  color:var(--muted);
  font-size:11px;
}
.legend span{
  display:flex;
  align-items:center;
  gap:5px;
}
.legend i{
  width:12px;
  height:12px;
  border-radius:4px;
  border:1px solid var(--line);
  background:var(--panel);
  display:inline-block;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 1px 2px rgba(0,0,0,.35);
}
.legend i.blocked{
  background:rgba(251,73,52,.10);
  border-color:rgba(251,73,52,.55);
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.04),
    inset -1px -1px 2px rgba(0,0,0,.45),
    0 0 4px rgba(251,73,52,.35);
}
.legend i.allow{
  background:var(--panel);
  border-color:var(--line);
}
.empty,.loading{padding:30px 12px;text-align:center;color:var(--muted)}
.footer{
  flex:none;
  padding:3px 6px;
  padding-bottom:calc(5px + env(safe-area-inset-bottom));
  color:var(--muted);
  font-size:11px;
  text-align:center;
  white-space:nowrap;
  opacity:.85;
}
.toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px 12px;z-index:100;color:var(--text);transition:opacity .12s,transform .12s}
.toast.show{opacity:1;transform:translate(-50%,0)}
.modal-back{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  display:none;
  align-items:center;
  justify-content:center;
  padding:16px;
  z-index:100;
}

.modal-back.show{
  display:flex;
}

.modal{
  width:100%;
  max-width:420px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  padding:14px;
  box-shadow:
    inset 1px 1px 3px rgba(255,255,255,.045),
    inset -2px -2px 4px rgba(0,0,0,.55),
    0 6px 14px rgba(0,0,0,.6);
}
.bulk-progress-modal{max-width:360px;padding:13px}.bulk-progress-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.bulk-progress-head h2{margin:0;font-size:17px}.bulk-progress-state{font-size:11px;font-weight:700;color:var(--muted);white-space:nowrap}.bulk-progress-state.ok{color:var(--engine-green)}.bulk-progress-state.err{color:var(--red)}.bulk-progress-track{height:8px;margin:12px 0 7px;background:var(--bg);border:1px solid var(--line);border-radius:5px;overflow:hidden;box-shadow:inset 1px 1px 3px rgba(0,0,0,.55)}.bulk-progress-bar{width:0;height:100%;background:var(--engine-green);border-radius:4px;box-shadow:0 0 5px rgba(142,192,124,.28);transition:width .12s ease}.bulk-progress-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:11px;margin-bottom:10px}.bulk-progress-error{display:none;color:var(--red);font-size:11px;line-height:1.35;margin:0 0 10px}.bulk-progress-error.show{display:block}.bulk-progress-modal button:disabled{opacity:.45;cursor:default}

.modal h2{
  font-size:18px;
  margin:0 0 8px;
}

.modal p{
  color:var(--muted);
  font-size:12px;
  line-height:1.35;
}

.modal button{
  width:100%;
  height:38px;
  margin-top:6px;
  border:1px solid var(--line);
  background:var(--panel2);
  border-radius:7px;
  box-shadow:
    inset 1px 1px 2px rgba(255,255,255,.035),
    inset -1px -1px 3px rgba(0,0,0,.45),
    0 2px 4px rgba(0,0,0,.35);
}

.modal .danger{
  color:var(--red);
}
</style>
</head>
<body>

<header class="header">
  <div class="header-row">
    <div>
      <div class="brand">TIRN SECURITY</div>
      <div class="statusline">
        <span id="engine">ENGINE …</span>
        <span>•</span>
        <span><b id="ruleCount">0</b> blocked</span>
      </div>
    </div>
    <div class="header-actions">
      <button class="icon-btn refresh" onclick="refreshAll()" title="Refresh">↻</button>
      <button class="icon-btn backup" onclick="showBackup()" title="Backup">⇅</button>
    </div>
  </div>
</header>

<section class="toolbar">
  <div class="filters">
    <button class="filter active" id="fAll" onclick="setAppFilter('all')">ALL</button>
    <button class="filter" id="fUser" onclick="setAppFilter('user')">USER</button>
    <button class="filter" id="fSystem" onclick="setAppFilter('system')">SYSTEM</button>
    <button class="filter" id="fBlocked" onclick="setAppFilter('blocked')">BLOCKED</button>
  </div>

  <div class="select-row">
    <div class="select custom-select" id="profileSelect">
      <span id="profileLabel">ALL PROFILES</span>
      <span class="select-arrow">▼</span>
      <div id="profileMenu" class="profile-menu"></div>
    </div>
  </div>

  <div class="search">
    <input id="search" type="search" placeholder="Search apps or package" autocomplete="off" oninput="render()"/>
  </div>

  <div class="bulk">
    <div class="network-row">
      <span>MOBILE DATA</span>
      <button onclick="bulkNetwork('MOBILE','BLOCK')" class="block">BLOCK</button>
      <button onclick="bulkNetwork('MOBILE','ALLOW')" class="allow">ALLOW</button>
    </div>
    <div class="network-row">
      <span>WIFI</span>
      <button onclick="bulkNetwork('WIFI','BLOCK')" class="block">BLOCK</button>
      <button onclick="bulkNetwork('WIFI','ALLOW')" class="allow">ALLOW</button>
    </div>
    <div class="network-row">
      <span>LAN</span>
      <button onclick="bulkNetwork('LAN','BLOCK')" class="block">BLOCK</button>
      <button onclick="bulkNetwork('LAN','ALLOW')" class="allow">ALLOW</button>
    </div>
  </div>

</section>

<div class="list-wrapper">

  <div class="matrix-head">
    <div class="apphead">APPLICATION</div>
    <div>MOBILE</div>
    <div>WIFI</div>
    <div>LAN</div>
  </div>

  <main id="list" class="list">
    <div id="appRows">
      <div class="loading">Loading TIRN Security…</div>
    </div>
  </main>

</div>

<div class="legend">
  <span><i class="blocked"></i> blocked</span>
  <span><i class="allow"></i> allowed</span>
  <span>tap a cell to change</span>
</div>

<div class="footer">
  TIRN Security manages only TIRN Security-owned chains.
</div>

<div id="toast" class="toast"></div>

<div id="modalBack" class="modal-back" onclick="if(event.target===this)hideBackup()">
  <div class="modal">
    <h2>Policy backup</h2>
    <p>Backups contain TIRN Security policy entries only. No Android firewall chains are modified by these operations.</p>
    <button onclick="exportBackup()">Export policy</button>
    <button onclick="document.getElementById('importFile').click()">Import policy</button>
    <button class="danger" onclick="clearAll()">Clear all TIRN Security blocks</button>
    <button onclick="hideBackup()">Cancel</button>
    <input id="importFile" type="file" accept=".json,application/json" hidden onchange="importBackup(this.files[0])"/>
  </div>
</div>

<div id="bulkProgressBack" class="modal-back" style="z-index:110">
  <div class="modal bulk-progress-modal">
    <div class="bulk-progress-head">
      <h2 id="bulkProgressTitle">Updating policy</h2>
      <span id="bulkProgressState" class="bulk-progress-state">RUNNING</span>
    </div>
    <p id="bulkProgressStatus">Applying TIRN Security policy changes…</p>
    <div class="bulk-progress-track">
      <div id="bulkProgressBar" class="bulk-progress-bar"></div>
    </div>
    <div class="bulk-progress-meta">
      <span id="bulkProgressCount">0 / 0</span>
      <span id="bulkProgressPercent">0%</span>
    </div>
    <p id="bulkProgressError" class="bulk-progress-error"></p>
    <button id="bulkProgressClose" onclick="hideBulkProgress()" disabled>Close</button>
  </div>
</div>

<div id="clearConfirmBack" class="modal-back" onclick="if(event.target===this)hideClearConfirm()">
  <div class="modal">
    <h2>Clear all TIRN Security blocks?</h2>
    <p>This will remove all TIRN Security policy rules. No Android firewall chains are modified by this operation.</p>
    <button class="danger" onclick="confirmClearAll()">Clear all blocks</button>
    <button onclick="hideClearConfirm()">Cancel</button>
  </div>
</div>

<script>
const API="/cgi-bin";

let apps=[];
let profiles=[];
let policy=new Map();
let appFilter="all";
let selectedProfile="all";
let writeBusy=false;

async function api(path,options={}){
  const response=await fetch(API+path,{
    cache:"no-store",
    credentials:"same-origin",
    ...options,
    headers:{
      "Accept":"application/json",
      ...(options.headers||{})
    }
  });

  const text=await response.text();

  let data;
  try{
    data=JSON.parse(text);
  }catch(e){
    throw new Error("Invalid server response");
  }

  if(!response.ok || data.status==="ERROR"){
    throw new Error(data.error||data.message||("HTTP "+response.status));
  }

  return data;
}

function esc(s){
  const d=document.createElement("div");
  d.textContent=String(s);
  return d.innerHTML;
}

function toast(s){
  const t=document.getElementById("toast");
  t.textContent=s;
  t.classList.add("show");
  clearTimeout(window.__toast);
  window.__toast=setTimeout(()=>t.classList.remove("show"),1800);
}

function updateRuleCount(){
  const el=document.getElementById("ruleCount");
  el.textContent=policy.size;
  el.classList.toggle("blocked-count",policy.size>0);
}

let policyRequestGeneration=0;

async function loadPolicy(){
  const requestGeneration=policyRequestGeneration;
  const data=await api("/policy");
  if(requestGeneration!==policyRequestGeneration)return;

  policy.clear();

  if(Array.isArray(data.rules)){
    data.rules.forEach(r=>{
      if(
        r &&
        /^\d+$/.test(String(r.uid)) &&
        ["MOBILE","WIFI","LAN"].includes(r.network) &&
        r.action==="BLOCK"
      ){
        policy.set(String(r.uid)+"|"+r.network,true);
      }
    });
  }

  updateRuleCount();
}

async function postPolicy(uid,network,action){
  return api("/policy",{
    method:"POST",
    headers:{
      "Content-Type":"application/json"
    },
    body:JSON.stringify({
      uid:String(uid),
      network:network,
      action:action
    })
  });
}

async function setPolicy(uid,network,blocked){
  if(writeBusy)return;

  writeBusy=true;

  try{
    const key=String(uid)+"|"+network;
    const action=blocked?"BLOCK":"ALLOW";

    await postPolicy(uid,network,action);

    if(blocked){
      policy.set(key,true);
    }else{
      policy.delete(key);
    }

    updateRuleCount();
    policySignature=getPolicySignature();
    toast("Policy updated");
  }finally{
    writeBusy=false;
  }
}

async function loadApps(){
  document.getElementById("appRows").innerHTML='<div class="loading">Enumerating apps…</div>';

  const data=await api("/apps");

  profiles=Array.isArray(data.profiles)?data.profiles.map(p=>({
    id:String(p.id),
    name:p.name||("User "+p.id)
  })):[{id:"0",name:"Owner"}];

  const seenProfiles=new Set();
  profiles=profiles.filter(p=>{
    if(seenProfiles.has(p.id))return false;
    seenProfiles.add(p.id);
    return true;
  });

  const label=document.getElementById("profileLabel");
  const menu=document.getElementById("profileMenu");

  menu.innerHTML=
    '<div class="profile-item" onclick="setProfile(\'all\')">ALL PROFILES</div>'+
    profiles.map(p=>
      '<div class="profile-item" onclick="setProfile(\''+
      esc(p.id)+
      '\')">'+
      esc(p.name)+' · '+esc(p.id)+
      '</div>'
    ).join("");

  const current=profiles.find(p=>p.id===selectedProfile);

  if(current){
    label.textContent=current.name+" · "+current.id;
  }else{
    selectedProfile="all";
    label.textContent="ALL PROFILES";
  }

  apps=[];

  if(Array.isArray(data.apps)){
    const seenApps=new Set();

    data.apps.forEach(a=>{
      if(!a || !a.pkg || !/^\d+$/.test(String(a.uid)))return;

      const user=String(a.user);
      const uid=String(a.uid);
      const pkg=String(a.pkg);
      const key=user+"|"+pkg;

      if(seenApps.has(key))return;
      seenApps.add(key);

      const profile=profiles.find(p=>p.id===user);

      apps.push({
        user:user,
        uid:uid,
        pkg:pkg,
        system:a.system===true,
        name:a.name||labelFor(pkg),
        profileName:profile?profile.name:("User "+user)
      });
    });
  }

  apps.sort((a,b)=>
    a.name.localeCompare(b.name)||
    a.pkg.localeCompare(b.pkg)
  );
}

function labelFor(pkg){
  const tail=String(pkg).split(".").pop().replace(/[_-]+/g," ");
  return tail
    ? tail.charAt(0).toUpperCase()+tail.slice(1)
    : pkg;
}

function setAppFilter(f){
  appFilter=f;

  ["All","User","System","Blocked"].forEach(x=>{
    document
      .getElementById("f"+x)
      .classList.toggle("active",f===x.toLowerCase());
  });

  render();
}

function setProfile(v){
  selectedProfile=v;

  const label=document.getElementById("profileLabel");
  const menu=document.getElementById("profileMenu");

  if(v==="all"){
    label.textContent="ALL PROFILES";
  }else{
    const p=profiles.find(x=>x.id===v);
    label.textContent=p?(p.name+" · "+p.id):"User "+v;
  }

  menu.classList.remove("show");
  render();
}

document.addEventListener("click",e=>{
  const box=document.getElementById("profileSelect");
  const menu=document.getElementById("profileMenu");

  if(!box||!menu)return;

  if(box.contains(e.target)){
    if(e.target.closest(".profile-item"))return;
    menu.classList.toggle("show");
  }else{
    menu.classList.remove("show");
  }
});

function visibleApps(){
  const q=document
    .getElementById("search")
    .value
    .trim()
    .toLowerCase();

  return apps.filter(a=>{
    if(selectedProfile!=="all"&&a.user!==selectedProfile)return false;
    if(appFilter==="user"&&a.system)return false;
    if(appFilter==="system"&&!a.system)return false;
    if(appFilter==="blocked" &&
       !["MOBILE","WIFI","LAN"].some(n=>blocked(a.uid,n)))return false;
    if(q&&!((a.name+" "+a.pkg).toLowerCase().includes(q)))return false;
    return true;
  });
}

function blocked(uid,n){
  return policy.has(String(uid)+"|"+n);
}

function render(){
  const list=document.getElementById("list");
  const rows=visibleApps();

  updateRuleCount();

  if(!rows.length){
    document.getElementById("appRows").innerHTML='<div class="empty">No matching apps</div>';
    return;
  }

  let h="";

  h+=rows.map(a=>{

    return(
      '<div class="app-row" data-key="'+
      esc(a.user+"|"+a.pkg)+
      '">'+

      '<div class="app-info">'+
        '<div class="app-top">'+

          '<div class="app-name">'+esc(a.name)+'</div>'+
        '</div>'+

        '<div class="meta">'+
          esc(a.pkg)+
          ' · <span class="profile">'+
          esc(a.profileName)+
          '</span> · UID '+
          esc(a.uid)+
          (a.system?' · SYS':'')+
        '</div>'+
      '</div>'+

      cell(a,"MOBILE","MOBILE")+
      cell(a,"WIFI","WIFI")+
      cell(a,"LAN","LAN")+

      '</div>'
    );
  }).join("");

  const rowsBox=document.getElementById("appRows");
  rowsBox.innerHTML=h;
}

function cell(a,n,label){
  const b=blocked(a.uid,n);

  return(
    '<label class="cell" title="'+
    label+" "+(b?"blocked":"allowed")+
    '">'+

    '<input type="checkbox" '+
    (b?"checked":"")+
    ' onchange="cellChange(\''+
    esc(a.uid)+
    '\',\''+
    n+
    '\',this.checked,this)">'+

    '<span class="dot">'+
    (b?"":"")+
    '</span>'+

    '</label>'
  );
}

async function cellChange(uid,n,b,el){
  const row=el.closest(".app-row");
  const dot=el.nextElementSibling;

  const scrollBox=document.getElementById("appRows");
  const scrollPos=scrollBox.scrollTop;

  el.disabled=true;

  try{
    await setPolicy(uid,n,b);

    dot.textContent=b?"":"";
    dot.parentElement.title=
      n+" "+(b?"blocked":"allowed");

    row.classList.add("changed");

    setTimeout(()=>{
      row.classList.remove("changed");
    },350);

    scrollBox.scrollTop=scrollPos;

  }catch(e){
    toast("Policy update failed");
    el.checked=!b;
  }finally{
    el.disabled=false;
  }
}

async function bulkNetwork(n,action){
  const rows=visibleApps();

  if(!rows.length){
    toast("No matching apps");
    return;
  }

  if(writeBusy){
    toast("Policy update in progress");
    return;
  }

  const block=action==="BLOCK";
  const total=rows.length;
  const label=(block?"Block ":"Allow ")+n;

  writeBusy=true;
  showBulkProgress(label,total);

  let done=0;

  try{
    for(const a of rows){
      await postPolicy(a.uid,n,action);

      const key=String(a.uid)+"|"+n;

      if(block){
        policy.set(key,true);
      }else{
        policy.delete(key);
      }

      done++;
      updateBulkProgress(done,total);
    }

    updateRuleCount();
    policySignature=getPolicySignature();
    render();
    finishBulkProgress(true,label+" complete","");
    toast("Policy updated");
  }catch(e){
    finishBulkProgress(false,"Stopped after "+done+" of "+total+" apps","PF-BULK-005");
    await loadPolicy().catch(()=>{});
    policySignature=getPolicySignature();
    render();
    toast("Bulk update failed");
  }finally{
    writeBusy=false;
  }
}

async function readNetwork(){
  try{
    const data=await api("/status");
    return data;
  }catch(e){
    throw e;
  }
}

async function readEngine(){
  try{
    const data=await api("/status");
    const on=data.engine==="ON";

    const e=document.getElementById("engine");

    e.textContent="ENGINE "+(on?"ON":"OFF");
    e.classList.remove("ok","bad"); e.classList.add(on?"ok":"bad");

    return on;
  }catch(e){
    const el=document.getElementById("engine");
    el.textContent="ENGINE ?";
    el.className="bad";
    throw e;
  }
}

async function refreshAll(){
  toast("Refreshing…");

  try{
    await loadPolicy();
    await loadApps();
    await readNetwork();
    await readEngine();
    render();
    toast("Refreshed");
  }catch(e){
    document.getElementById("list").innerHTML=
      '<div class="empty">TIRN Security CGI unavailable</div>';
    toast("Refresh failed");
  }
}

function showBackup(){
  document.getElementById("modalBack").classList.add("show");
}

function hideBackup(){
  document.getElementById("modalBack").classList.remove("show");
}

function exportBackup(){
  const data={
    version:3,
    type:"TIRN Security",
    timestamp:new Date().toISOString(),
    policy:Array.from(policy.keys()).map(k=>{
      const p=k.split("|");
      const uid=p[0];
      const network=p[1];
      const app=apps.find(a=>String(a.uid)===uid);
      return{
        uid:uid,
        network:network,
        action:"BLOCK",
        app:app?{
          name:app.name,
          pkg:app.pkg,
          user:app.user,
          profile:app.profileName,
          system:app.system
        }:null
      };
    })
  };
  const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download="tirn-security-policy-"+(()=>{const d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")+"-"+String(d.getHours()).padStart(2,"0")+String(d.getMinutes()).padStart(2,"0")})()+".json";
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>{URL.revokeObjectURL(url)},1000);
  hideBackup();
  toast("Policy exported");
}

async function importBackup(file){
  if(!file)return;

  try{
    const text=await file.text();
    const d=JSON.parse(text);

    if(
      d.type!=="TIRN Security"||
      !Array.isArray(d.policy)
    ){
      throw new Error("Invalid backup");
    }

    const next=new Map();

    d.policy.forEach(x=>{
      if(
        x &&
        /^\d+$/.test(String(x.uid)) &&
        ["MOBILE","WIFI","LAN"].includes(x.network) &&
        x.action==="BLOCK"
      ){
        next.set(
          String(x.uid)+"|"+x.network,
          true
        );
      }
    });

    if(writeBusy){
      toast("Policy update in progress");
      return;
    }

    const current=policy;
    const changes=[];

    for(const key of current.keys()){
      if(!next.has(key)){
        changes.push([key,"ALLOW"]);
      }
    }

    for(const key of next.keys()){
      if(!current.has(key)){
        changes.push([key,"BLOCK"]);
      }
    }

    writeBusy=true;
    hideBackup();
    showBulkProgress("Import policy",changes.length);

    let done=0;

    for(const [key,action] of changes){
      const p=key.split("|");
      await postPolicy(p[0],p[1],action);
      done++;
      updateBulkProgress(done,changes.length);
    }

    policy=next;
    updateRuleCount();
    policySignature=getPolicySignature();
    render();
    finishBulkProgress(true,"Import policy complete","");
    toast("Policy imported");
  }catch(e){
    finishBulkProgress(false,"Import policy failed","PF-BULK-006");
    await loadPolicy().catch(()=>{});
    policySignature=getPolicySignature();
    render();
    toast("Import failed");
  }finally{
    writeBusy=false;
  }

  document.getElementById("importFile").value="";
}

async function clearAll(){
  if(!policy.size){
    hideBackup();
    toast("Nothing to clear");
    return;
  }

  showClearConfirm();
}

function showBulkProgress(title,total){
  const back=document.getElementById("bulkProgressBack");
  const state=document.getElementById("bulkProgressState");
  const close=document.getElementById("bulkProgressClose");
  document.getElementById("bulkProgressTitle").textContent=title;
  document.getElementById("bulkProgressStatus").textContent="Applying TIRN Security policy changes…";
  document.getElementById("bulkProgressBar").style.width="0%";
  document.getElementById("bulkProgressCount").textContent="0 / "+total;
  document.getElementById("bulkProgressPercent").textContent="0%";
  document.getElementById("bulkProgressError").textContent="";
  document.getElementById("bulkProgressError").classList.remove("show");
  state.textContent="RUNNING";
  state.className="bulk-progress-state";
  close.disabled=true;
  back.style.display="flex";
}

function updateBulkProgress(done,total){
  const percent=total?Math.round((done/total)*100):100;
  document.getElementById("bulkProgressBar").style.width=percent+"%";
  document.getElementById("bulkProgressCount").textContent=done+" / "+total;
  document.getElementById("bulkProgressPercent").textContent=percent+"%";
}

function finishBulkProgress(success,message,code){
  const state=document.getElementById("bulkProgressState");
  const close=document.getElementById("bulkProgressClose");
  const status=document.getElementById("bulkProgressStatus");
  const error=document.getElementById("bulkProgressError");
  state.textContent=success?"COMPLETE":"FAILED";
  state.className="bulk-progress-state "+(success?"ok":"err");
  status.textContent=message;
  if(success){
    error.textContent="";
    error.classList.remove("show");
  }else{
    error.textContent=code+(message?" — "+message:"");
    error.classList.add("show");
  }
  close.disabled=false;
}

function hideBulkProgress(){
  if(writeBusy)return;
  document.getElementById("bulkProgressBack").style.display="none";
}

function showClearConfirm(){
  document.getElementById("clearConfirmBack").style.display="flex";
}

function hideClearConfirm(){
  document.getElementById("clearConfirmBack").style.display="none";
}

async function confirmClearAll(){
  hideClearConfirm();

  if(writeBusy){
    toast("Policy update in progress");
    return;
  }

  writeBusy=true;
  policyRequestGeneration++;

  try{
    await api("/clear");
    policy.clear();
    policySignature=getPolicySignature();
    hideBackup();
    render();
    toast("Policy cleared");
  }catch(e){
    toast("Clear failed");
  }finally{
    writeBusy=false;
  }
}

async function init(){
  try{
    await loadPolicy();
    await loadApps();
    await readNetwork();
    await readEngine();
    render();
  }catch(e){
    console.error("TIRN Security init failed:",e);
    document.getElementById("list").innerHTML=
      '<div class="empty">'+String(e)+'</div>';
    toast("TIRN Security CGI unavailable");
  }
}

let policyRefreshBusy=false;
let policySignature="";

function getPolicySignature(){
  return Array.from(policy.keys()).sort().join("\n");
}

async function refreshPolicy(force=false){
  if(policyRefreshBusy || writeBusy || document.visibilityState!=="visible") return;
  policyRefreshBusy=true;
  try{
    const before=policySignature;
    await loadPolicy();
    const after=getPolicySignature();
    if(force || after!==before){
      policySignature=after;
      render();
    }
  }catch(e){
    console.error("TIRN Security policy refresh failed:",e);
  }finally{
    policyRefreshBusy=false;
  }
}

window.addEventListener("pageshow",()=>refreshPolicy(true));
window.addEventListener("focus",()=>refreshPolicy(true));

setInterval(()=>{
  refreshPolicy(false);
},10000);

init();
</script>
