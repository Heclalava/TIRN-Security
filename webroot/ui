<script>
const API="/cgi-bin";

let clearLogTarget="system";
let apps=[];
let profiles=[];
let policy=new Map();
let appliedPolicy=new Map();
let policyApplyBusy=false;
let appFilter="all";
let selectedProfile="all";
let writeBusy=false;

async function api(path,options={}){
  const response=await fetch(API+path,{
    cache:"no-store",
    credentials:"same-origin",
    ...options,
    headers:{
      "Accept":"application/json",
      ...(options.headers||{})
    }
  });

  const text=await response.text();

  let data;
  try{
    data=JSON.parse(text);
  }catch(e){
    throw new Error("Invalid server response");
  }

  if(!response.ok || data.status==="ERROR"){
    throw new Error(data.error||data.message||("HTTP "+response.status));
  }

  return data;
}

function esc(s){
  const d=document.createElement("div");
  d.textContent=String(s);
  return d.innerHTML;
}

function toast(s){
  const t=document.getElementById("toast");
  t.textContent=s;
  t.classList.add("show");
  clearTimeout(window.__toast);
  window.__toast=setTimeout(()=>t.classList.remove("show"),1800);
}

function updateRuleCount(){
  const el=document.getElementById("ruleCount");
  el.textContent=policy.size;
  el.classList.toggle("blocked-count",policy.size>0);
}

function getAppliedPolicySignature(){
  return Array.from(appliedPolicy.keys()).sort().join("\n");
}

function hasPendingPolicyChanges(){
  return getPolicySignature()!==getAppliedPolicySignature();
}

function updatePendingBar(){
  const count=document.getElementById("pendingCount");
  const button=document.getElementById("applyPendingButton");
  if(!count || !button)return;

  const pending=hasPendingPolicyChanges();

  if(pending){
    const added=Array.from(policy.keys()).filter(k=>!appliedPolicy.has(k)).length;
    const removed=Array.from(appliedPolicy.keys()).filter(k=>!policy.has(k)).length;
    const total=added+removed;

    count.textContent=
      total+
      " pending change"+
      (total===1?"":"s");

    button.disabled=policyApplyBusy;
  }else{
    count.textContent="No pending changes";
    button.disabled=true;
  }
}

function transactionCandidateFromPolicy(source){
  const candidate=new Map();

  source.forEach((value,key)=>{
    const parts=key.split("|");
    if(parts.length!==4)return;
    candidate.set(key+"|BLOCK",true);
  });

  return candidate;
}

function uiPolicyFromTransactionCandidate(candidate){
  const next=new Map();

  candidate.forEach((value,key)=>{
    const parts=key.split("|");
    if(parts.length===5 && parts[4]==="BLOCK"){
      next.set(parts.slice(0,4).join("|"),true);
    }
  });

  return next;
}

let staleAuditData={
  status:"OK",
  summary:{total_block_rules:0,valid:0,stale:0,stale_apps:0},
  stale_rules:[]
};
let staleAuditBusy=false;

function updateStaleAuditCount(){
  const count=document.getElementById("staleRuleCount");
  const button=document.getElementById("staleCount");
  const stale=Number(staleAuditData?.summary?.stale||0);

  count.textContent=stale;
  button.classList.toggle("stale",stale>0);
  button.title=stale
    ? stale+" stale policy rule"+(stale===1?"":"s")+" detected"
    : "No stale policy rules detected";
}

function renderStaleAudit(){
  const summary=document.getElementById("staleAuditSummary");
  const rules=document.getElementById("staleAuditRules");
  const data=staleAuditData||{};
  const s=data.summary||{};
  const stale=Number(s.stale||0);
  const staleApps=Number(s.stale_apps||0);

  summary.textContent=
    stale
      ? stale+" stale rule"+(stale===1?"":"s")+
        " across "+staleApps+
        " affected app"+(staleApps===1?"":"s")+
        ". No policy changes were made."
      : "No stale policy rules detected. No policy changes were made.";

  rules.innerHTML="";

  if(!stale){
    rules.innerHTML='<div class="empty">Policy is consistent with the current application cache.</div>';
    return;
  }

  (Array.isArray(data.stale_rules)?data.stale_rules:[]).forEach(item=>{
    const row=document.createElement("div");
    row.className="stale-audit-rule";

    const title=document.createElement("div");
    title.className="stale-audit-rule-title";
    title.textContent=String(item.name||item.pkg||"Unknown application");

    const detail=document.createElement("div");
    detail.className="stale-audit-rule-detail";

    const reason=item.reason==="UID_CHANGED"
      ? "UID changed"
      : item.reason==="APP_MISSING"
        ? "App is not installed"
        : String(item.reason||"Unknown");

    const uid=item.current_uid
      ? "UID "+String(item.uid||"")+" → "+String(item.current_uid)
      : "UID "+String(item.uid||"");

    const networks=Array.isArray(item.networks)&&item.networks.length
      ? " · Networks: "+item.networks.join(", ")
      : "";

    detail.textContent=
      reason+
      " · User "+String(item.user||"")+
      " · "+
      uid+
      networks+
      " · Package: "+
      String(item.pkg||"");

    row.appendChild(title);
    row.appendChild(detail);
    rules.appendChild(row);
  });
}

async function scanStaleRules(showModal=false){
  if(staleAuditBusy||writeBusy)return;

  staleAuditBusy=true;
  document.getElementById("staleAuditClose").disabled=true;
  const rules=document.getElementById("staleAuditRules");
  const summary=document.getElementById("staleAuditSummary");

  if(showModal){
    setTaskStatus("SCANNING");
    showImportProcessingModal(
      "Scanning for stale firewall rules",
      "Checking current application UIDs and packages."
    );
  }

  try{
    const data=await api("/policy-stale-scan");
    staleAuditData=data;
    updateStaleAuditCount();

    const stale=Number(data?.summary?.stale||0);

    if(showModal&&stale>0&&Array.isArray(data.stale_rules)){
      const importRules=[];

      data.stale_rules.forEach(x=>{
        const networks=Array.isArray(x.networks)
          ? x.networks
          : x.network
            ? [x.network]
            : [];

        networks.forEach(network=>{
          importRules.push({
            ...x,
            network:String(network),
            app:{
              name:x.name,
              pkg:x.pkg,
              user:x.user,
              profile:x.profile||""
            },
            current:x.current_uid
              ? {
                  uid:x.current_uid,
                  name:x.current_name||"",
                  profile:x.current_profile||""
                }
              : {}
          });
        });
      });

      staleImportCandidate=new Map();
      policy.forEach((value,key)=>{
        staleImportCandidate.set(key+"|BLOCK",value);
      });

      importRules.forEach(x=>{
        const key=
          String(x.user)+"|"+
          String(x.pkg)+"|"+
          String(x.uid)+"|"+
          String(x.network)+"|BLOCK";
        staleImportCandidate.delete(key);
      });

      staleImportBusy=false;
      staleImportCommitStarted=false;
      staleImportMode="audit";
      writeBusy=true;

      if(showModal)hideImportProcessingModal();
      showStaleImportModal(importRules);
      return;
    }

    if(showModal){
      hideImportProcessingModal();
      renderStaleAudit();
      document.getElementById("staleAuditBack").classList.add("show");
    }
  }catch(e){
    console.error("TIRN Security stale policy scan failed:",e);

    if(showModal){
      hideImportProcessingModal();
      summary.textContent="Stale policy scan failed.";
      rules.innerHTML='<div class="empty">The policy audit endpoint is unavailable. The previous audit result has been retained.</div>';
      document.getElementById("staleAuditBack").classList.add("show");
    }

    const button=document.getElementById("staleCount");
    button.title="Stale policy audit unavailable";
    setTaskStatus("ERROR");
  }finally{
    staleAuditBusy=false;
    document.getElementById("staleAuditClose").disabled=false;
    if(!writeBusy)setTaskStatus("READY");
  }
}

function showStaleAuditModal(){
  document.getElementById("staleAuditBack").classList.add("show");
  document.getElementById("staleAuditClose").disabled=staleAuditBusy;
  renderStaleAudit();
}

function hideStaleAuditModal(){
  if(staleAuditBusy)return;
  document.getElementById("staleAuditBack").classList.remove("show");
}

let policyRequestGeneration=0;

async function loadPolicy(){
  const requestGeneration=policyRequestGeneration;
  const data=await api("/policy");
  if(requestGeneration!==policyRequestGeneration)return;

  const next=new Map();

  if(Array.isArray(data.rules)){
    data.rules.forEach(r=>{
      if(
        r &&
        /^\d+$/.test(String(r.uid)) &&
        ["MOBILE","WIFI","LAN"].includes(r.network) &&
        r.action==="BLOCK"
      ){
        next.set(
          String(r.user)+"|"+String(r.pkg)+"|"+String(r.uid)+"|"+r.network,
          true
        );
      }
    });
  }

  policy=new Map(next);
  appliedPolicy=new Map(next);
  updateRuleCount();
  updatePendingBar();
}

async function setPolicy(user,pkg,uid,network,blocked){
  if(writeBusy)return;

  writeBusy=true;

  try{
    const key=
      String(user)+"|"+
      String(pkg)+"|"+
      String(uid)+"|"+
      network;

    if(blocked){
      policy.set(key,true);
    }else{
      policy.delete(key);
    }

    updateRuleCount();
    policySignature=getPolicySignature();
    updatePendingBar();
    toast("Policy updated");
  }finally{
    writeBusy=false;
  }
}

async function refreshAppsList(){
  if(writeBusy)return;
  try{
    await loadApps();
    render();
  }catch(e){
    console.error("TIRN Security app list refresh failed:",e);
    setTaskStatus("ERROR");
    setTimeout(()=>setTaskStatus("READY"),2000);
  }
}

async function refreshAppCache(){
  if(writeBusy)return;
  writeBusy=true;
  showAppRefreshProgress("Refresh app cache",0);
  try{
    const data=await api("/refresh-apps",{method:"POST"});
    if(!data || data.status!=="OK"){
      throw new Error(data?.message||"App cache refresh failed");
    }

    for(;;){
      const progress=await api("/apps-refresh-progress");
      if(!progress || progress.status==="ERROR"){
        throw new Error(progress?.message||"App cache refresh failed");
      }

      if(progress.status==="RUNNING" || progress.status==="COMPLETE"){
        const processed=Number(progress.processed)||0;
        const total=Number(progress.total)||0;
        if(progress.status==="RUNNING"){
          const state=document.getElementById("appRefreshProgressState");
          const status=document.getElementById("appRefreshProgressStatus");
          state.textContent="RUNNING";
          state.className="bulk-progress-state";
          status.textContent="Refreshing application cache…";
        }
        updateAppRefreshProgress(processed,total);
      }else if(progress.status==="IDLE"){
        const state=document.getElementById("appRefreshProgressState");
        const status=document.getElementById("appRefreshProgressStatus");
        state.textContent="PREPARING";
        state.className="bulk-progress-state";
        status.textContent="Preparing application cache…";
        document.getElementById("appRefreshProgressCount").textContent="Preparing…";
        document.getElementById("appRefreshProgressPercent").textContent="—";
        document.getElementById("appRefreshProgressBar").style.width="0%";
      }

      if(progress.status==="COMPLETE")break;
      await new Promise(resolve=>setTimeout(resolve,1000));
    }

    await loadApps();
    render();

    const revisionData=await api("/apps-revision");
    if(revisionData && revisionData.status==="OK" && revisionData.revision!==undefined){
      appRevision=String(revisionData.revision);
    }

    finishAppRefreshProgress(true,"App cache refreshed");
  }catch(e){
    console.error("TIRN Security app cache refresh failed:",e);
    finishAppRefreshProgress(false,"App cache refresh failed","REFRESH_ERROR");
  }finally{
    writeBusy=false;
  }
}

async function loadApps(){
  document.getElementById("appRows").innerHTML='<div class="loading">Enumerating apps…</div>';

  const data=await api("/apps");

  profiles=Array.isArray(data.profiles)?data.profiles.map(p=>({
    id:String(p.id),
    name:p.name||("User "+p.id)
  })):[{id:"0",name:"Owner"}];

  const seenProfiles=new Set();
  profiles=profiles.filter(p=>{
    if(seenProfiles.has(p.id))return false;
    seenProfiles.add(p.id);
    return true;
  });

  const label=document.getElementById("profileLabel");
  const menu=document.getElementById("profileMenu");

  menu.innerHTML=
    '<div class="profile-item" onclick="setProfile(\'all\')">ALL PROFILES</div>'+
    profiles.map(p=>
      '<div class="profile-item" onclick="setProfile(\''+
      esc(p.id)+
      '\')">'+
      esc(p.name)+' · '+esc(p.id)+
      '</div>'
    ).join("");

  const current=profiles.find(p=>p.id===selectedProfile);

  if(current){
    label.textContent=current.name+" · "+current.id;
  }else{
    selectedProfile="all";
    label.textContent="ALL PROFILES";
  }

  apps=[];

  if(Array.isArray(data.apps)){
    const seenApps=new Set();

    data.apps.forEach(a=>{
      if(!a || !a.pkg || !/^\d+$/.test(String(a.uid)))return;

      const user=String(a.user);
      const uid=String(a.uid);
      const pkg=String(a.pkg);
      const key=user+"|"+pkg;

      if(seenApps.has(key))return;
      seenApps.add(key);

      const profile=profiles.find(p=>p.id===user);

      apps.push({
        user:user,
        uid:uid,
        pkg:pkg,
        system:a.system===true,
        name:a.name||labelFor(pkg),
        profileName:profile?profile.name:("User "+user)
      });
    });
  }

  apps.sort((a,b)=>
    a.name.localeCompare(b.name)||
    a.pkg.localeCompare(b.pkg)
  );
}

function labelFor(pkg){
  const tail=String(pkg).split(".").pop().replace(/[_-]+/g," ");
  return tail
    ? tail.charAt(0).toUpperCase()+tail.slice(1)
    : pkg;
}

