async function commitImportedPolicy(candidate,endpoint="/policy-import-commit"){
  const lines=Array.from(candidate.keys()).sort();
  const body=lines.length?lines.join("\n")+"\n":"";

  const result=await api(endpoint,{
    method:"POST",
    headers:{
      "Content-Type":"text/plain"
    },
    body:body
  });

  if(!result||result.status!=="OK"){
    throw new Error(
      result&&result.message
        ? result.message
        : endpoint==="/policy-stale-commit"
          ? "Stale policy reconciliation commit failed"
          : "Policy import commit failed"
    );
  }

  return result;
}

