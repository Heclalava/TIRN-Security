      reject.textContent="Reject";
      reject.disabled=staleImportBusy;
      reject.onclick=()=>resolveStaleImport(index,false);

      buttons.appendChild(reject);

      if(item.reason==="UID_CHANGED"){
        const accept=document.createElement("button");
        accept.type="button";
        accept.className="stale-import-accept";
        accept.textContent="Accept & Reassign";
        accept.disabled=staleImportBusy;
        accept.onclick=()=>resolveStaleImport(index,true);
        buttons.appendChild(accept);
      }

      row.appendChild(buttons);
    }

    rules.appendChild(row);
  });

  updateStaleImportSummary();
}

async function resolveStaleImport(index,accept){
  const item=staleImportItems[index];

  if(!item||item.state!=="pending"||staleImportBusy)return;

  if(!accept){
    item.state="rejected";
    renderStaleImportRules();
    await finishStaleImportIfDone();
    return;
  }

  if(
    item.reason!=="UID_CHANGED"||
    String(item.user)===""||
    String(item.pkg)===""||
    String(item.currentUid)===""||
    !Array.isArray(item.networks)||
    !item.networks.length
  ){
    toast("Unable to reassign this stale rule");
    return;
  }

  staleImportBusy=true;
  renderStaleImportRules();

  try{
    const completed=item.acceptedNetworks||[];

    for(const network of item.networks){
      if(completed.includes(network))continue;

      const key=
        String(item.user)+"|"+
        String(item.pkg)+"|"+
        String(item.currentUid)+"|"+
        network+"|BLOCK";

      staleImportCandidate.set(key,true);
      completed.push(network);
    }

    item.state="accepted";
    item.acceptedNetworks=completed;
  }catch(e){
    console.error(
      "TIRN Security stale policy reassignment failed:",
      e
    );
    toast("Policy reassignment failed");
  }finally{
    staleImportBusy=false;
    renderStaleImportRules();
    await finishStaleImportIfDone();
  }
}

async function acceptAllStaleUidChanges(){
  if(staleImportBusy)return;

  const indexes=[];

  staleImportItems.forEach((item,index)=>{
    if(item.state==="pending"&&item.reason==="UID_CHANGED"){
      indexes.push(index);
    }
  });

  if(!indexes.length)return;

  staleImportBusy=true;
  renderStaleImportRules();

  let failed=0;

  try{
    for(const index of indexes){
      const item=staleImportItems[index];

      try{
        const completed=item.acceptedNetworks||[];

        for(const network of item.networks){
          if(completed.includes(network))continue;

          const key=
            String(item.user)+"|"+
            String(item.pkg)+"|"+
            String(item.currentUid)+"|"+
            network+"|BLOCK";

          staleImportCandidate.set(key,true);
          completed.push(network);
        }

        item.state="accepted";
        item.acceptedNetworks=completed;
      }catch(e){
        failed++;
        console.error(
          "TIRN Security stale policy reassignment failed:",
          e
        );
      }
    }
  }finally{
    staleImportBusy=false;
    renderStaleImportRules();

    if(failed){
      toast(
        "Accepted "+(indexes.length-failed)+
        " of "+indexes.length+
        " UID changes"
      );
    }

    await finishStaleImportIfDone();
  }
}

function rejectAllStaleImports(){
  if(staleImportBusy)return;

  staleImportItems.forEach(item=>{
    if(item.state==="pending"){
      item.state="rejected";
    }
  });

  renderStaleImportRules();
  finishStaleImportIfDone();
}

async function finishStaleImportIfDone(){
  const pending=staleImportItems.some(
    x=>x.state==="pending"
  );

  updateRuleCount();
  policySignature=getPolicySignature();
  render();

  if(pending)return;

  if(staleImportCommitStarted)return;

  if(hasPendingPolicyChanges()){
    staleImportCommitStarted=false;
    staleImportBusy=false;
    hideStaleImportModal();
    setTaskStatus("ERROR");
    toast("Apply pending policy changes first");
    return;
  }

  staleImportCommitStarted=true;
  staleImportBusy=true;
  renderStaleImportRules();

  hideStaleImportModal();
  setTaskStatus("UPDATING");
  const reconciliationMode=staleImportMode==="audit";
  showImportProcessingModal(
    reconciliationMode
      ? "Reconciling stale firewall rules"
      : "Applying policy changes",
    reconciliationMode
      ? "Applying your stale rule choices and rebuilding the firewall policy."
      : "Applying your imported policy and rebuilding the firewall policy."
  );

  try{
    await commitImportedPolicy(staleImportCandidate,"/policy-stale-commit");
    applyImportedPolicy(staleImportCandidate);

    staleAuditData={
      status:"OK",
      summary:{
        total_block_rules:policy.size,
        valid:policy.size,
        stale:0,
        stale_apps:0
      },
      stale_rules:[]
    };
    updateStaleAuditCount();

    const c=staleImportCounts();

    hideImportProcessingModal();
    setTaskStatus("READY");
    toast(
      "Stale policy rules processed: "+
      c.accepted+
      " reassigned, "+
      c.rejected+
      " rejected."
    );
  }catch(e){
    console.error(
      "TIRN Security stale policy reconciliation failed:",
      e
    );

    staleImportCommitStarted=false;

    hideImportProcessingModal();
    setTaskStatus("ERROR");
    toast("Stale policy reconciliation failed");
    return;
  }finally{
    staleImportBusy=false;
    writeBusy=false;
    renderStaleImportRules();
    updateRuleCount();
    policySignature=getPolicySignature();
    render();
  }
}

