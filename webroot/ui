let importWaitTimer=null;

function showAppRefreshProgress(title,total){
  setTaskStatus(title==="Import policy"?"IMPORTING":title==="Refresh app cache"?"REFRESHING":"UPDATING");
  const back=document.getElementById("appRefreshProgressBack");
  const state=document.getElementById("appRefreshProgressState");
  const close=document.getElementById("appRefreshProgressClose");
  const status=document.getElementById("appRefreshProgressStatus");
  const track=document.querySelector(".bulk-progress-track");
  const meta=document.querySelector(".bulk-progress-meta");

  if(importWaitTimer){
    clearInterval(importWaitTimer);
    importWaitTimer=null;
  }

  document.getElementById("appRefreshProgressTitle").textContent=title;
  const preparing=title==="Refresh app cache";
  const importing=title==="Import policy";

  if(importing){
    status.textContent="Please wait.";
    track.style.display="none";
    meta.style.display="none";

    let dots=1;
    importWaitTimer=setInterval(()=>{
      dots=dots===3?1:dots+1;
      status.textContent="Please wait"+".".repeat(dots);
    },500);
  }else{
    status.textContent=preparing?"Preparing application cache…":"Refreshing application cache…";
    track.style.display="block";
    meta.style.display="flex";
    document.getElementById("appRefreshProgressBar").style.width="0%";
    document.getElementById("appRefreshProgressCount").textContent=preparing?"Preparing…":"0 / "+total;
    document.getElementById("appRefreshProgressPercent").textContent=preparing?"—":"0%";
  }

  document.getElementById("appRefreshProgressError").textContent="";
  document.getElementById("appRefreshProgressError").classList.remove("show");
  state.textContent=preparing?"PREPARING":"RUNNING";
  state.className="bulk-progress-state";
  close.disabled=true;
  back.style.display="flex";
}

function updateAppRefreshProgress(done,total){
  const percent=total?Math.round((done/total)*100):100;
  document.getElementById("appRefreshProgressBar").style.width=percent+"%";
  document.getElementById("appRefreshProgressCount").textContent=done+" / "+total;
  document.getElementById("appRefreshProgressPercent").textContent=percent+"%";
}

function finishAppRefreshProgress(success,message,code){
  const state=document.getElementById("appRefreshProgressState");
  const close=document.getElementById("appRefreshProgressClose");
  const status=document.getElementById("appRefreshProgressStatus");
  const error=document.getElementById("appRefreshProgressError");
  const importing=!!importWaitTimer;

  if(importWaitTimer){
    clearInterval(importWaitTimer);
    importWaitTimer=null;
  }

  state.textContent=success?"COMPLETE":"FAILED";
  state.className="bulk-progress-state "+(success?"ok":"err");
  status.textContent=message;
  if(success){
    error.textContent="";
    error.classList.remove("show");
    setTaskStatus("READY");

    if(importing){
      document.getElementById("appRefreshProgressBack").style.display="none";
      return;
    }
  }else{
    error.textContent=code+(message?" — "+message:"");
    error.classList.add("show");
    setTaskStatus("ERROR");
  }
  close.disabled=false;
}

function hideAppRefreshProgress(){
  if(writeBusy)return;
  document.getElementById("appRefreshProgressBack").style.display="none";
