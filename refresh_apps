#!/system/bin/sh

PM="/system/bin/pm"
DATA_DIR="/data/adb/tirnsecurity"
CACHE="$DATA_DIR/apps.json"
LOCK="$DATA_DIR/apps.lock"
. "$DATA_DIR/app-common.sh" 2>/dev/null || exit 1
TMP="$DATA_DIR/apps.json.$$"
USERS="$DATA_DIR/users.$$"
LABELS="$DATA_DIR/labels.conf"
APK_LABEL="/data/adb/modules/tirnsecurity/apklabel"
APK_LABELS="$DATA_DIR/apklabels.$$"
APK_PATHS="$DATA_DIR/apkpaths.$$"
APK_LABEL_CACHE="$DATA_DIR/apk-label-cache.$$"
APK_UNIQUE="$DATA_DIR/apk-unique.$$"
ELIGIBLE_PKGS="$DATA_DIR/eligible-pkgs.$$"

trap 'rm -f "$TMP" "$USERS" "$APK_LABELS" "$APK_PATHS" "$APK_LABEL_CACHE" "$APK_UNIQUE" "$ELIGIBLE_PKGS" "$DATA_DIR"/systems.* "$DATA_DIR"/packages.* "$DATA_DIR"/apps.[0-9]*' EXIT

mkdir -p "$DATA_DIR" || exit 1

get_proc_start() {
    PID="$1"
    STAT="/proc/$PID/stat"
    [ -r "$STAT" ] || return 1
    /system/bin/sed 's/.*) //' "$STAT" 2>/dev/null |
        /system/bin/awk '{print $20}'
}

LOCK_OWNER="$LOCK/owner"

acquire_apps_lock() {
    if mkdir "$LOCK" 2>/dev/null; then
        SELF_START="$(get_proc_start "$$")" || {
            rmdir "$LOCK" 2>/dev/null
            return 1
        }
        printf '%s %s\n' "$$" "$SELF_START" > "$LOCK_OWNER" || {
            rm -f "$LOCK_OWNER" 2>/dev/null
            rmdir "$LOCK" 2>/dev/null
            return 1
        }
        return 0
    fi

    [ -r "$LOCK_OWNER" ] || return 2

    read -r LOCK_PID LOCK_START < "$LOCK_OWNER" || return 2

    case "$LOCK_PID" in
        ''|*[!0-9]*) return 2 ;;
    esac

    case "$LOCK_START" in
        ''|*[!0-9]*) return 2 ;;
    esac

    CURRENT_START="$(get_proc_start "$LOCK_PID")" || {
        rm -f "$LOCK_OWNER" 2>/dev/null || return 2
        rmdir "$LOCK" 2>/dev/null || return 2
        if mkdir "$LOCK" 2>/dev/null; then
            SELF_START="$(get_proc_start "$$")" || {
                rmdir "$LOCK" 2>/dev/null
                return 1
            }
            printf '%s %s\n' "$$" "$SELF_START" > "$LOCK_OWNER" || {
                rm -f "$LOCK_OWNER" 2>/dev/null
                rmdir "$LOCK" 2>/dev/null
                return 1
            }
            return 0
        fi
        return 2
    }

    [ "$CURRENT_START" = "$LOCK_START" ] && return 2

    rm -f "$LOCK_OWNER" 2>/dev/null || return 2
    rmdir "$LOCK" 2>/dev/null || return 2

    if mkdir "$LOCK" 2>/dev/null; then
        SELF_START="$(get_proc_start "$$")" || {
            rmdir "$LOCK" 2>/dev/null
            return 1
        }
        printf '%s %s\n' "$$" "$SELF_START" > "$LOCK_OWNER" || {
            rm -f "$LOCK_OWNER" 2>/dev/null
            rmdir "$LOCK" 2>/dev/null
            return 1
        }
        return 0
    fi

    return 2
}

if ! acquire_apps_lock; then
    echo "Apps cache busy" >&2
    exit 2
fi

trap 'rm -f "$TMP" "$USERS" "$APK_LABELS" "$APK_PATHS" "$APK_LABEL_CACHE" "$APK_UNIQUE" "$ELIGIBLE_PKGS" "$DATA_DIR"/systems.* "$DATA_DIR"/packages.* "$DATA_DIR"/apps.[0-9]* "$LOCK_OWNER"; rmdir "$LOCK" 2>/dev/null' EXIT


"$PM" list users 2>/dev/null |
/system/bin/sed -n 's/.*UserInfo{\([0-9][0-9]*\):\([^:}]*\):.*/\1|\2/p' |
/system/bin/sort -t'|' -k1,1n -u > "$USERS" || exit 1

printf '{"status":"OK","profiles":[' > "$TMP"

first=1
while IFS='|' read -r user name
do
    [ -z "$user" ] && continue

    [ "$first" -eq 0 ] && printf ',' >> "$TMP"

    printf '{"id":"%s","name":"%s"}' "$user" "$name" >> "$TMP"

    first=0
done < "$USERS"

printf '],"apps":[' >> "$TMP"

first=1

: > "$APK_LABELS"

"$PM" list packages -f -U 2>/dev/null |
/system/bin/sed -n 's/^package:\(.*\.apk\)=\([^ ]*\).*/\2|\1/p' > "$APK_PATHS"

for user in $(/system/bin/cut -d'|' -f1 "$USERS")
do
    [ -z "$user" ] && continue

    SYSTEMS="$DATA_DIR/systems.$user"
    PKGS="$DATA_DIR/packages.$user"
    OUT="$DATA_DIR/apps.$user"

    "$PM" list packages -s --user "$user" 2>/dev/null |
    /system/bin/sed 's/^package://' > "$SYSTEMS"

    "$PM" list packages --user "$user" -U 2>/dev/null |
    /system/bin/sed -n 's/^package:\([^ ]*\) uid:\([0-9]*\)$/\1|\2/p' |
    /system/bin/sed "s/$/|$user/" > "$PKGS"
done

: > "$APK_UNIQUE"
: > "$ELIGIBLE_PKGS"

for user in $(/system/bin/cut -d'|' -f1 "$USERS")
do
    [ -z "$user" ] && continue

    PKGS="$DATA_DIR/packages.$user"

    while IFS='|' read -r pkg uid appuser
    do
        [ -z "$pkg" ] && continue

        case "$uid" in
            0|1000|1001|2000) continue ;;
        esac

        apk=$(/system/bin/awk -F'|' -v p="$pkg" '$1 == p {print $2; exit}' "$APK_PATHS")

        [ -z "$apk" ] && continue

        printf '%s|%s|%s|%s\n' "$pkg" "$uid" "$appuser" "$apk" >> "$ELIGIBLE_PKGS"
        printf '%s\n' "$apk" >> "$APK_UNIQUE"
    done < "$PKGS"
done

/system/bin/sort -u -o "$APK_UNIQUE" "$APK_UNIQUE"

: > "$APK_LABEL_CACHE"

while IFS= read -r apk
do
    [ -z "$apk" ] && continue

    name="$(get_apk_label "$apk")"
    case "$name" in
        *"
"*|*"	"*) name="" ;;
    esac

    if [ -n "$name" ]; then
        printf '%s|%s\n' "$apk" "$name" >> "$APK_LABEL_CACHE"
    fi
done < "$APK_UNIQUE"

/system/bin/awk -F'|' '
    NR == FNR {
        apk_path[$1] = $2
        next
    }

    FILENAME == ARGV[2] {
        if ($1 != "" && $2 != "")
            apk_label[$1] = $2
        next
    }

    {
        pkg = $1
        apk = $4

        if (pkg != "" && apk != "" && (apk in apk_label))
            print pkg "|" apk_label[apk]
    }
' "$APK_PATHS" "$APK_LABEL_CACHE" "$ELIGIBLE_PKGS" > "$APK_LABELS"

for user in $(/system/bin/cut -d'|' -f1 "$USERS")
do
    [ -z "$user" ] && continue

    SYSTEMS="$DATA_DIR/systems.$user"
    PKGS="$DATA_DIR/packages.$user"
    OUT="$DATA_DIR/apps.$user"

    /system/bin/awk -F'|' '
        BEGIN {
            while ((getline line < ARGV[3]) > 0) {
                split(line, a, "=")
                if (a[1] != "")
                    override[a[1]] = substr(line, length(a[1]) + 2)
            }
            close(ARGV[3])
            delete ARGV[3]

            while ((getline line < ARGV[4]) > 0) {
                split(line, a, "|")
                if (a[1] != "" && a[2] != "")
                    apklabel[a[1]] = a[2]
            }
            close(ARGV[4])
            delete ARGV[4]

            first = 1
        }

        NR == FNR {
            sys_pkg[$0] = 1
            next
        }

        {
            pkg = $1
            uid = $2
            appuser = $3

            if (uid == "0" || uid == "1000" || uid == "1001" || uid == "2000")
                next

            if (pkg in sys_pkg)
                is_system = "true"
            else
                is_system = "false"

            if (pkg in override) {
                name = override[pkg]
            } else if (pkg in apklabel) {
                name = apklabel[pkg]
            } else {
                n = split(pkg, parts, ".")
                name = ""

                for (i = 2; i <= n; i++) {
                    part = parts[i]

                    if (part == "android" || part == "google" || part == "com" || part == "org" || part == "net" || part == "app")
                        continue

                    gsub(/[_-]/, " ", part)
                    part = toupper(substr(part, 1, 1)) substr(part, 2)

                    if (name == "")
                        name = part
                    else
                        name = name " " part
                }

                if (name == "")
                    name = pkg
            }

            gsub(/\\/,"\\\\",pkg)
            gsub(/"/,"\\\"",pkg)
            gsub(/\\/,"\\\\",name)
            gsub(/"/,"\\\"",name)

            if (!first)
                printf ","

            printf "{\"user\":\"%s\",\"uid\":\"%s\",\"pkg\":\"%s\",\"name\":\"%s\",\"system\":%s}", appuser, uid, pkg, name, is_system

            first = 0
        }
    ' "$SYSTEMS" "$PKGS" "$LABELS" "$APK_LABELS" > "$OUT"

    if [ -s "$OUT" ]; then
        if [ "$first" -eq 0 ]; then
            printf ',' >> "$TMP"
        fi

        cat "$OUT" >> "$TMP"
        first=0
    fi
done

printf ']}\n' >> "$TMP"

mv -f "$TMP" "$CACHE" || exit 1

chmod 644 "$CACHE"

echo "Apps cache refreshed"
